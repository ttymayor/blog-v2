---
import Layout from "@/layouts/Layout.astro";
import { ArrowLeft, Dot } from "@lucide/astro";
import RelativeTime from "@/components/RelativeTime.astro";

interface Props {
  id: string;
  pubDate: string;
}

const { id, pubDate } = Astro.props;
const transitionId = id.replaceAll("/", "-");
const transitionName = `jotting-item-${transitionId}`;
const persistName = `jotting-state-${transitionId}`;
---

<Layout title="隨筆">
  <main class="page-container">
    <a
      href="/jotting"
      data-jotting-back
      class="text-muted-foreground hover:text-foreground mb-8 inline-flex items-center gap-2 text-sm no-underline transition-colors"
    >
      <ArrowLeft class="size-4" />
      返回隨筆
    </a>
    <div class="border-border -mx-4 overflow-hidden sm:rounded-4xl sm:border">
      <div
        class="relative p-5"
        transition:name={transitionName}
        transition:animate="initial"
      >
        <header class="mb-5 flex flex-row items-center gap-1.5 text-sm">
          <span class="font-semibold">tantuyu</span>
          <span class="text-muted-foreground font-light">@tantuyu</span>
          <Dot class="size-2" />
          <time datetime={pubDate} class="text-muted-foreground font-light">
            <RelativeTime dateStr={pubDate} />
          </time>
        </header>
        <div
          class="prose jotting-prose gap-5 font-serif"
          transition:persist={persistName}
        >
          <slot />
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  function initJottingBackLink() {
    const link = document.querySelector<HTMLAnchorElement>(
      "[data-jotting-back]",
    );
    if (!link || link.dataset.initialized) return;
    link.dataset.initialized = "true";

    link.addEventListener("click", (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        history.state?.fromJottingIndex !== true
      )
        return;

      event.preventDefault();
      history.back();
    });
  }

  initJottingBackLink();
  document.addEventListener("astro:page-load", initJottingBackLink);
</script>
