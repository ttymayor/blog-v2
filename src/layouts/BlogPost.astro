---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { Separator } from "@/components/ui/separator";
import TableOfContents from "@/components/mdx/TableOfContents.astro";
import {
  Calendar,
  Clock,
  FileText,
  Timer,
  Type,
  Undo2,
  ChevronLeft,
  ChevronRight,
} from "@lucide/astro";
import type { BlogPost as BlogPostType } from "@/types/blog";
import { Badge } from "@/components/ui/badge";
import PostActions from "@/components/PostActions";
import { Button } from "@/components/ui/button";
import { relativeTime } from "@/lib/utils";

const {
  title,
  description,
  heroImage,
  headings,
  category,
  tags,
  minutesRead,
  wordCount,
  pubDate,
  lastModified,
  readMinutes,
  slug,
  body,
  prevPost,
  nextPost,
} = Astro.props;

const ogImage = slug ? `/og/${slug}.png` : undefined;

const modifiedDate = lastModified ? new Date(lastModified) : undefined;
const readTime: Number = Math.round(readMinutes);

const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
const aiPrompt = `請幫我了解並討論這篇文章：「${title}」\n${articleUrl}`;
const encodedPrompt = encodeURIComponent(aiPrompt);
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="hidden md:block md:h-22" aria-hidden="true"></div>

  <div class="max-w-7xl w-full mx-auto px-4 py-12">
    <div class="flex gap-8">
      <!-- Left: back to list -->
      <div class="hidden lg:block w-40 shrink-0">
        <div class="sticky top-24">
          <a href="/blog">
            <Button
              client:idle
              variant="ghost"
              size="xs"
              className="text-muted-foreground"
            >
              <Undo2 />
              文章列表
            </Button>
          </a>
        </div>
      </div>

      <!-- Center: article -->

      <article id="content" class="min-w-0 flex-1 max-w-4xl mx-auto">
        {
          heroImage && (
            <div class="md:mb-8 mb-4">
              <Image width={1020} height={510} src={heroImage} alt="" />
            </div>
          )
        }
        <div class="flex flex-row justify-between mb-4 gap-4">
          <div class="flex flex-col gap-2">
            {
              category && (
                <Badge
                  variant={"default"}
                  style={{
                    viewTransitionName: `post-category-${slug.replace(/\//g, "-")}`,
                  }}
                >
                  {category}
                </Badge>
              )
            }
            <h1
              id="article-title"
              class="font-serif w-fit text-3xl md:text-4xl font-bold"
              transition:name={`post-title-${slug.replace(/\//g, "-")}`}
            >
              {title}
            </h1>
          </div>
          <PostActions
            body={body ?? ""}
            encodedPrompt={encodedPrompt}
            client:load
          />
        </div>
        <div
          class="flex flex-row items-center gap-4 text-muted-foreground text-xs flex-wrap mb-4"
        >
          {
            modifiedDate && (
              <div class="flex items-center gap-1.5">
                <Calendar class="size-4" />
                <span class="font-serif font-bold">
                  {relativeTime(pubDate)}
                </span>
              </div>
            )
          }
          {
            minutesRead && (
              <div class="flex items-center gap-1.5">
                <Timer class="size-4" />
                <span class="font-serif font-bold">{readTime} 分鐘</span>
              </div>
            )
          }
          {
            wordCount && (
              <div class="flex items-center gap-1.5">
                <Type class="size-4" />
                <span class="font-serif font-bold">約 {wordCount} 字</span>
              </div>
            )
          }
        </div>

        <Separator className="mt-6 mb-6" client:load />
        <div class="prose">
          <slot />
          {
            tags && tags.length > 0 && (
              <>
                <Separator className="mt-6 mb-6" client:load />
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag: string) => (
                    <Badge
                      client:load
                      variant={"secondary"}
                      className="rounded-xs"
                    >
                      {tag}
                    </Badge>
                  ))}
                </div>
              </>
            )
          }
        </div>

        {
          (prevPost || nextPost) && (
            <>
              <Separator className="mt-8 mb-6" client:load />
              <nav class="grid grid-cols-2 gap-4 not-prose">
                <div>
                  {prevPost && (
                    <a
                      href={`/blog/${prevPost.id}`}
                      class="flex flex-col gap-1 group"
                    >
                      <span class="text-muted-foreground text-xs flex items-center gap-1">
                        <ChevronLeft class="size-3" />
                        上一篇
                      </span>
                      <span
                        class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-2 font-serif"
                        transition:name={`post-title-${prevPost.id.replace(/\//g, "-")}`}
                      >
                        {prevPost.title}
                      </span>
                    </a>
                  )}
                </div>
                <div class="text-right">
                  {nextPost && (
                    <a
                      href={`/blog/${nextPost.id}`}
                      class="flex flex-col gap-1 items-end group"
                    >
                      <span class="text-muted-foreground text-xs flex items-center gap-1">
                        下一篇
                        <ChevronRight class="size-3" />
                      </span>
                      <span
                        class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-2 font-serif"
                        transition:name={`post-title-${nextPost.id.replace(/\//g, "-")}`}
                      >
                        {nextPost.title}
                      </span>
                    </a>
                  )}
                </div>
              </nav>
            </>
          )
        }
      </article>

      <!-- Right: TOC -->
      <div class="hidden lg:block w-55 shrink-0">
        <div class="sticky top-24">
          <TableOfContents headings={headings ?? []} />
        </div>
      </div>
    </div>

    <script>
      function setupCopyButtons() {
        const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
        const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;

        document.querySelectorAll(".prose pre").forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-wrapper")) return;
          const wrapper = document.createElement("div");
          wrapper.className = "code-wrapper";
          pre.parentNode!.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const btn = document.createElement("button");
          btn.className = "copy-btn";
          btn.innerHTML = copyIcon;
          btn.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            if (!code) return;
            await navigator.clipboard.writeText(code.textContent || "");
            btn.innerHTML = checkIcon;
            btn.classList.add("copied");
            setTimeout(() => {
              btn.innerHTML = copyIcon;
              btn.classList.remove("copied");
            }, 2000);
          });
          wrapper.appendChild(btn);
        });
      }

      document.addEventListener("astro:page-load", setupCopyButtons);
    </script>
  </div>
</BaseLayout>
