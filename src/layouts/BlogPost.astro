---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import { Separator } from "@/components/ui/separator";
import TableOfContents from "@/components/mdx/TableOfContents.astro";
import {
  Calendar,
  Timer,
  Type,
  Undo2,
  ChevronLeft,
  ChevronRight,
  TriangleAlert,
} from "@lucide/astro";
import BlankBlock from "@/components/BlankBlock.astro";
import { Badge } from "@/components/ui/badge";
import PostActions from "@/components/PostActions";
import { Button } from "@/components/ui/button";
import RelativeTime from "@/components/react/RelativeTime";

const {
  title,
  description,
  heroImage,
  headings,
  category,
  tags,
  minutesRead,
  wordCount,
  pubDate,
  lastModified,
  readMinutes,
  slug,
  body,
  prevPost,
  nextPost,
  chatWithAI,
} = Astro.props;

const ogImage = heroImage
  ? (await getImage({ src: heroImage })).src
  : slug
    ? `/og/${slug}.png`
    : undefined;

const modifiedDate: Date | undefined = lastModified?.isValid?.() ? lastModified.toDate() : undefined;
const readTime: Number = Math.round(readMinutes);
const isOutdated = modifiedDate && !isNaN(modifiedDate.getTime()) && Date.now() - modifiedDate.getTime() > 180 * 24 * 60 * 60 * 1000;

let aiPrompt = "";
let encodedPrompt = "";
if (chatWithAI) {
  const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
  aiPrompt = `請幫我了解並討論這篇文章：「${title}」\n${articleUrl}`;
  encodedPrompt = encodeURIComponent(aiPrompt);
}
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <BlankBlock />

  <div class="max-w-7xl w-full mx-auto px-4 py-12">
    <div class="flex gap-8">
      <!-- Left: back to list -->
      <div class="hidden lg:block w-40 shrink-0">
        <div class="sticky top-30 flex justify-end">
          <a href="/blog">
            <Button
              client:idle
              variant="ghost"
              size="xs"
              className="text-muted-foreground"
            >
              <Undo2 />
              文章列表
            </Button>
          </a>
        </div>
      </div>

      <!-- Center: article -->
      <article id="content" class="min-w-0 w-full">
        {
          heroImage && (
            <div class="md:mb-8 mb-4">
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt="hero image"
                class="rounded-xl"
                style={{
                  viewTransitionName: `post-hero-${slug.replace(/\//g, "-")}`,
                }}
              />
            </div>
          )
        }
        <div class="flex flex-row justify-between mb-4 gap-4">
          <div class="flex flex-col gap-2">
            {
              category && (
                <Badge
                  variant={"default"}
                  style={{
                    viewTransitionName: `post-category-${slug.replace(/\//g, "-")}`,
                  }}
                >
                  {category}
                </Badge>
              )
            }
            <h1
              id="article-title"
              class="font-serif w-fit text-3xl md:text-4xl font-bold m-0 text-[clamp(1.75rem, 4vw, 2.25rem)]"
              transition:name={`post-title-${slug.replace(/\//g, "-")}`}
            >
              {title}
            </h1>
          </div>
          {
            chatWithAI && (
              <PostActions
                body={body ?? ""}
                encodedPrompt={encodedPrompt}
                client:load
              />
            )
          }
        </div>
        <div
          class="flex flex-row items-center gap-4 text-muted-foreground text-xs flex-wrap mb-4"
        >
          {
            modifiedDate && (
              <div class="flex items-center gap-1.5">
                <Calendar class="size-4" />
                <span class="font-serif font-bold -translate-y-px">
                  <RelativeTime dateStr={pubDate} client:load />
                </span>
              </div>
            )
          }
          {
            minutesRead && (
              <div class="flex items-center gap-1.5">
                <Timer class="size-4" />
                <span class="font-serif font-bold -translate-y-px">{readTime} 分鐘</span>
              </div>
            )
          }
          {
            wordCount && (
              <div class="flex items-center gap-1.5">
                <Type class="size-4" />
                <span class="font-serif font-bold -translate-y-px">約 {wordCount} 字</span>
              </div>
            )
          }
        </div>

        <!-- Warning for outdated post -->
        { isOutdated && (
          <>
            <div class="flex items-center gap-2 p-4 bg-card border rounded-md ">
              <TriangleAlert class="size-3.5 text-yellow-500/50" />
              <span class="text-muted-foreground text-sm font-serif font-bold -translate-y-px">此文章可能已經過時，內容僅供參考。</span>
            </div>
          </>
        )}

        <Separator className="my-6" client:load />
        <div class="prose">
          <slot />
          {
            tags && tags.length > 0 && (
              <>
                <Separator client:load />
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag: string) => (
                    <Badge
                      client:load
                      variant={"secondary"}
                      className="rounded-xs"
                    >
                      {tag}
                    </Badge>
                  ))}
                </div>
              </>
            )
          }
        </div>

        {
          (prevPost || nextPost) && (
            <>
              <Separator className="my-6" client:load />
              <nav class="grid grid-cols-2 gap-4 not-prose">
                <div>
                  {prevPost && (
                    <a
                      href={`/blog/${prevPost.id}`}
                      class="flex flex-col gap-1 group"
                    >
                      <span class="text-muted-foreground text-xs flex items-center gap-1 group-hover:-translate-x-2 transition-all">
                        <ChevronLeft class="size-3" />
                        上一篇
                      </span>
                      <span
                        class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-2 font-serif"
                        transition:name={`post-title-${prevPost.id.replace(/\//g, "-")}`}
                      >
                        {prevPost.title}
                      </span>
                    </a>
                  )}
                </div>
                <div class="text-right">
                  {nextPost && (
                    <a
                      href={`/blog/${nextPost.id}`}
                      class="flex flex-col gap-1 items-end group"
                    >
                      <span class="text-muted-foreground text-xs flex items-center gap-1 group-hover:translate-x-2 transition-all">
                        下一篇
                        <ChevronRight class="size-3" />
                      </span>
                      <span
                        class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-2 font-serif"
                        transition:name={`post-title-${nextPost.id.replace(/\//g, "-")}`}
                      >
                        {nextPost.title}
                      </span>
                    </a>
                  )}
                </div>
              </nav>
            </>
          )
        }
      </article>

      <!-- Right: TOC -->
      <div class="hidden lg:block w-55 shrink-0">
        <div class="sticky top-30">
          <TableOfContents headings={headings ?? []} />
        </div>
      </div>
    </div>

    <script>
      function setupCopyButtons() {
        document.querySelectorAll<HTMLButtonElement>(".code-block .copy-btn").forEach((btn) => {
          if (btn.dataset.initialized) return;
          btn.dataset.initialized = "true";
          let copying = false;
          btn.addEventListener("click", async () => {
            if (copying) return;
            copying = true;
            const code = btn.closest(".code-block")?.querySelector("code");
            if (!code) { copying = false; return; }
            await navigator.clipboard.writeText(code.textContent || "");
            const swap = btn.querySelector(".t-icon-swap") as HTMLElement;
            if (swap) swap.dataset.state = "b";
            await new Promise<void>((r) => setTimeout(r, 2000));
            if (swap) swap.dataset.state = "a";
            copying = false;
          });
        });
      }

      setupCopyButtons();
      document.addEventListener("astro:page-load", setupCopyButtons);
    </script>

    <script>
      import PhotoSwipeLightbox from "photoswipe/lightbox";
      import PhotoSwipe from "photoswipe";
      import "photoswipe/style.css";

      let lightbox: PhotoSwipeLightbox | null = null;

      function initPhotoSwipe() {
        // Destroy previous instance on navigation
        if (lightbox) {
          lightbox.destroy();
          lightbox = null;
        }

        lightbox = new PhotoSwipeLightbox({
          gallery: "article",
          children: ".lightbox-trigger",
          pswpModule: PhotoSwipe,
        });
        lightbox.init();
      }

      // Initialize on load and Astro view transitions
      initPhotoSwipe();
      document.addEventListener("astro:page-load", initPhotoSwipe);
    </script>

  </div>
</BaseLayout>
