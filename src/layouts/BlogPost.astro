---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import { Separator } from "@/components/ui/separator";
import TableOfContents from "@/components/mdx/TableOfContents.astro";
import {
  Calendar,
  Timer,
  Type,
  Undo2,
  ChevronLeft,
  ChevronRight,
} from "@lucide/astro";
import BlankBlock from "@/components/BlankBlock.astro";
import { Badge } from "@/components/ui/badge";
import PostActions from "@/components/PostActions";
import { Button } from "@/components/ui/button";
import RelativeTime from "@/components/react/RelativeTime";

const {
  title,
  description,
  heroImage,
  headings,
  category,
  tags,
  minutesRead,
  wordCount,
  pubDate,
  lastModified,
  readMinutes,
  slug,
  body,
  prevPost,
  nextPost,
  chatWithAI,
} = Astro.props;

const ogImage = heroImage
  ? (await getImage({ src: heroImage })).src
  : slug
    ? `/og/${slug}.png`
    : undefined;

const modifiedDate = lastModified ? new Date(lastModified) : undefined;
const readTime: Number = Math.round(readMinutes);

let aiPrompt = "";
let encodedPrompt = "";
if (chatWithAI) {
  const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
  aiPrompt = `請幫我了解並討論這篇文章：「${title}」\n${articleUrl}`;
  encodedPrompt = encodeURIComponent(aiPrompt);
}
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <BlankBlock />

  <div class="max-w-7xl w-full mx-auto px-4 py-12">
    <div class="flex gap-8">
      <!-- Left: back to list -->
      <div class="hidden lg:block w-40 shrink-0">
        <div class="sticky top-30 flex justify-end">
          <a href="/blog">
            <Button
              client:idle
              variant="ghost"
              size="xs"
              className="text-muted-foreground"
            >
              <Undo2 />
              文章列表
            </Button>
          </a>
        </div>
      </div>

      <!-- Center: article -->
      <article id="content" class="min-w-0">
        {
          heroImage && (
            <div class="md:mb-8 mb-4">
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                style={{
                  viewTransitionName: `post-hero-${slug.replace(/\//g, "-")}`,
                }}
              />
            </div>
          )
        }
        <div class="flex flex-row justify-between mb-4 gap-4">
          <div class="flex flex-col gap-2">
            {
              category && (
                <Badge
                  variant={"default"}
                  style={{
                    viewTransitionName: `post-category-${slug.replace(/\//g, "-")}`,
                  }}
                >
                  {category}
                </Badge>
              )
            }
            <h1
              id="article-title"
              class="font-serif w-fit text-3xl md:text-4xl font-bold m-0 text-[clamp(1.75rem, 4vw, 2.25rem)]"
              transition:name={`post-title-${slug.replace(/\//g, "-")}`}
            >
              {title}
            </h1>
          </div>
          {
            chatWithAI && (
              <PostActions
                body={body ?? ""}
                encodedPrompt={encodedPrompt}
                client:load
              />
            )
          }
        </div>
        <div
          class="flex flex-row items-center gap-4 text-muted-foreground text-xs flex-wrap mb-4"
        >
          {
            modifiedDate && (
              <div class="flex items-center gap-1.5">
                <Calendar class="size-4" />
                <span class="font-serif font-bold">
                  <RelativeTime dateStr={pubDate} client:load />
                </span>
              </div>
            )
          }
          {
            minutesRead && (
              <div class="flex items-center gap-1.5">
                <Timer class="size-4" />
                <span class="font-serif font-bold">{readTime} 分鐘</span>
              </div>
            )
          }
          {
            wordCount && (
              <div class="flex items-center gap-1.5">
                <Type class="size-4" />
                <span class="font-serif font-bold">約 {wordCount} 字</span>
              </div>
            )
          }
        </div>

        <Separator className="my-6" client:load />
        <div class="prose">
          <slot />
          {
            tags && tags.length > 0 && (
              <>
                <Separator client:load />
                <div class="flex flex-wrap gap-2">
                  {tags.map((tag: string) => (
                    <Badge
                      client:load
                      variant={"secondary"}
                      className="rounded-xs"
                    >
                      {tag}
                    </Badge>
                  ))}
                </div>
              </>
            )
          }
        </div>

        {
          (prevPost || nextPost) && (
            <>
              <Separator className="my-6" client:load />
              <nav class="grid grid-cols-2 gap-4 not-prose">
                <div>
                  {prevPost && (
                    <a
                      href={`/blog/${prevPost.id}`}
                      class="flex flex-col gap-1 group"
                    >
                      <span class="text-muted-foreground text-xs flex items-center gap-1 group-hover:-translate-x-2 transition-all">
                        <ChevronLeft class="size-3" />
                        上一篇
                      </span>
                      <span
                        class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-2 font-serif"
                        transition:name={`post-title-${prevPost.id.replace(/\//g, "-")}`}
                      >
                        {prevPost.title}
                      </span>
                    </a>
                  )}
                </div>
                <div class="text-right">
                  {nextPost && (
                    <a
                      href={`/blog/${nextPost.id}`}
                      class="flex flex-col gap-1 items-end group"
                    >
                      <span class="text-muted-foreground text-xs flex items-center gap-1 group-hover:translate-x-2 transition-all">
                        下一篇
                        <ChevronRight class="size-3" />
                      </span>
                      <span
                        class="text-sm font-medium group-hover:text-primary transition-colors line-clamp-2 font-serif"
                        transition:name={`post-title-${nextPost.id.replace(/\//g, "-")}`}
                      >
                        {nextPost.title}
                      </span>
                    </a>
                  )}
                </div>
              </nav>
            </>
          )
        }
      </article>

      <!-- Right: TOC -->
      <div class="hidden lg:block w-55 shrink-0">
        <div class="sticky top-30">
          <TableOfContents headings={headings ?? []} />
        </div>
      </div>
    </div>

    <script>
      function setupCopyButtons() {
        const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
        const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;

        function swapIcon(btn: HTMLButtonElement, html: string): Promise<void> {
          return new Promise((resolve) => {
            const span = btn.querySelector(".copy-btn-icon") as HTMLElement;
            span.style.animation = "copy-icon-out 0.08s ease forwards";
            span.addEventListener(
              "animationend",
              () => {
                span.innerHTML = html;
                span.style.animation = "copy-icon-in 0.1s ease forwards";
                span.addEventListener(
                  "animationend",
                  () => {
                    span.style.animation = "";
                    resolve();
                  },
                  { once: true },
                );
              },
              { once: true },
            );
          });
        }

        document.querySelectorAll(".prose pre").forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-wrapper")) return;
          const wrapper = document.createElement("div");
          wrapper.className = "code-wrapper";
          pre.parentNode!.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const btn = document.createElement("button");
          btn.className = "copy-btn";
          btn.innerHTML = `<span class="copy-btn-icon">${copyIcon}</span>`;
          let copying = false;
          btn.addEventListener("click", async () => {
            if (copying) return;
            copying = true;
            const code = pre.querySelector("code");
            if (!code) {
              copying = false;
              return;
            }
            await navigator.clipboard.writeText(code.textContent || "");
            btn.classList.add("copied");
            await swapIcon(btn, checkIcon);
            await new Promise<void>((r) => setTimeout(r, 2000));
            btn.classList.remove("copied");
            await swapIcon(btn, copyIcon);
            copying = false;
          });
          wrapper.appendChild(btn);
        });
      }

      setupCopyButtons();
      document.addEventListener("astro:page-load", setupCopyButtons);
    </script>

    <script>
      import PhotoSwipeLightbox from "photoswipe/lightbox";
      import PhotoSwipe from "photoswipe";
      import "photoswipe/style.css";

      let lightbox: PhotoSwipeLightbox | null = null;

      function initPhotoSwipe() {
        // Destroy previous instance on navigation
        if (lightbox) {
          lightbox.destroy();
          lightbox = null;
        }

        lightbox = new PhotoSwipeLightbox({
          gallery: "article",
          children: ".lightbox-trigger",
          pswpModule: PhotoSwipe,
        });
        lightbox.init();
      }

      // Initialize on load and Astro view transitions
      initPhotoSwipe();
      document.addEventListener("astro:page-load", initPhotoSwipe);
    </script>

    <style>
      @keyframes copy-icon-out {
        from {
          transform: scale(1);
          filter: blur(0px);
          opacity: 1;
        }
        to {
          transform: scale(0.3);
          filter: blur(3px);
          opacity: 0;
        }
      }
      @keyframes copy-icon-in {
        from {
          transform: scale(0.3);
          filter: blur(3px);
          opacity: 0;
        }
        to {
          transform: scale(1);
          filter: blur(0px);
          opacity: 1;
        }
      }
      .copy-btn-icon {
        display: flex;
        align-items: center;
      }
    </style>
  </div>
</BaseLayout>
