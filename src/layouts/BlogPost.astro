---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import FormattedDate from "@/components/FormattedDate.astro";
import { Separator } from "@/components/ui/separator";
import { Badge } from "@/components/ui/badge";
import TableOfContents from "@/components/mdx/TableOfContents.astro";
import { Calendar } from "@lucide/astro";

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings,
  category,
} = Astro.props;
---

<BaseLayout>
  <div class="lg:flex lg:gap-4 lg:items-start relative">
    <article
      id="content"
      class="bg-card border shadow-2xl p-4 rounded-xl md:p-8 flex-1 min-w-0 max-w-4xl"
      data-scroll
    >
      {
        heroImage && (
          <div class="md:mb-8 mb-4">
            <Image width={1020} height={510} src={heroImage} alt="" />
          </div>
        )
      }
      <div class="prose space-y-2">
        <div class="flex flex-row items-center gap-2">
          {
            category && (
              <Badge
                client:load
                className="text-sm h-fit dark:border-[#eebbc3] dark:text-[#eebbc3] dark:bg-[#eebbc3]/10 rounded-sm"
              >
                {category}
              </Badge>
            )
          }
          <h1 class="font-bold m-0">{title}</h1>
        </div>
        <div
          class="flex flex-row items-center gap-2 text-muted-foreground text-sm"
        >
          <Calendar class="size-4" />
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <div class="last-updated-on">
                Last updated on <FormattedDate date={updatedDate} />
              </div>
            )
          }
        </div>
        <Separator className="mt-8 mb-10 bg-gray-500" client:only="react" />
        <slot />
      </div>
    </article>

    {
      headings && headings.length > 0 && (
        <aside class="hidden p-4 bg-card border shadow-2xl rounded-xl lg:block w-64 sticky top-26 shrink-0 self-start">
          <TableOfContents headings={headings} />
        </aside>
      )
    }
  </div>
</BaseLayout>
