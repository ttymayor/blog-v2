---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import type { BlogPost as BlogPostSummary } from "@/types/blog";
import { Image, getImage } from "astro:assets";
import Separator from "@/components/ui/Separator.astro";
import TableOfContents from "@/components/mdx/TableOfContents.astro";
import {
  Calendar,
  Timer,
  Type,
  Undo2,
  ChevronLeft,
  ChevronRight,
  TriangleAlert,
} from "@lucide/astro";
import Badge from "@/components/ui/Badge.astro";
import { Button } from "@/components/ui/button";
import RelativeTime from "@/components/RelativeTime.astro";
import TegakiRenderer from "tegaki/astro";
import bundle from "tegaki/fonts/caveat";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

type Props = CollectionEntry<"blog">["data"] & {
  headings: Heading[];
  minutesRead: string;
  wordCount: number;
  readMinutes: number;
  slug: string;
  body?: string;
  prevPost: BlogPostSummary | null;
  nextPost: BlogPostSummary | null;
};

const {
  title,
  description,
  heroImage,
  headings,
  category,
  tags,
  minutesRead,
  wordCount,
  pubDate,
  readMinutes,
  slug,
  body,
  prevPost,
  nextPost,
  chatWithAI,
} = Astro.props;

const ogImage = heroImage
  ? (await getImage({ src: heroImage })).src
  : slug
    ? `/og/${slug}.png`
    : undefined;

const publishedAt = new Date(pubDate).getTime();
const readTime: number = Math.round(readMinutes);
const isOutdated =
  Number.isFinite(publishedAt) &&
  Date.now() - publishedAt > 180 * 24 * 60 * 60 * 1000;

let aiPrompt = "";
let encodedPrompt = "";
if (chatWithAI) {
  const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
  aiPrompt = `請幫我了解並討論這篇文章：「${title}」\n${articleUrl}`;
  encodedPrompt = encodeURIComponent(aiPrompt);
}
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <div class="mx-auto w-full max-w-370 px-4 py-12">
    <div class="flex gap-8">
      <!-- Left: back to list -->
      <div class="hidden w-[15%] shrink-0 lg:block">
        <div class="sticky top-30 flex justify-end">
          <a href="/blog">
            <Button
              client:idle
              variant="ghost"
              size="xs"
              className="text-muted-foreground"
            >
              <Undo2 />
              文章列表
            </Button>
          </a>
        </div>
      </div>

      <!-- Center: article -->
      <article id="content" class="w-full min-w-0">
        {
          heroImage && (
            <div class="mb-4 md:mb-8">
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt="hero image"
                class="rounded-xl"
                transition:name={`article-hero-${slug.replaceAll("/", "-")}`}
              />
            </div>
          )
        }
        <section class="mb-4 flex flex-col gap-4" data-article-header>
          {
            (category || tags.length > 0) && (
              <div class="flex flex-row flex-wrap gap-2">
                {category && <Badge variant="category">{category}</Badge>}
                {tags.length > 0 &&
                  tags.map((tag) => (
                    <Badge variant="tag" class="">
                      #{tag}
                    </Badge>
                  ))}
              </div>
            )
          }
          <h1
            id="article-title"
            class="text-[clamp(1.75rem, 4vw, 2.25rem)] m-0 w-fit font-serif text-3xl font-bold md:text-4xl"
            transition:name={`article-title-${slug.replaceAll("/", "-")}`}
          >
            {title}
          </h1>
          <div
            class="text-muted-foreground flex flex-wrap items-center gap-4 text-xs"
          >
            {
              pubDate && (
                <div class="flex items-center gap-1.5">
                  <Calendar class="size-4" />
                  <span class="font-serif font-bold">
                    <RelativeTime dateStr={pubDate} />
                  </span>
                </div>
              )
            }
            {
              minutesRead && (
                <div class="flex items-center gap-1.5">
                  <Timer class="size-4" />
                  <span class="font-serif font-bold">{readTime} 分鐘</span>
                </div>
              )
            }
            {
              wordCount && (
                <div class="flex items-center gap-1.5">
                  <Type class="size-4" />
                  <span class="font-serif font-bold">約 {wordCount} 字</span>
                </div>
              )
            }
          </div>
        </section>

        <!-- Warning for outdated post -->
        {
          isOutdated && (
            <>
              <div class="bg-card flex items-center gap-2 rounded-md border p-4">
                <TriangleAlert class="size-3.5 text-yellow-500/50" />
                <span class="text-muted-foreground -translate-y-px font-serif text-sm font-bold">
                  此文章可能已經過時，內容僅供參考。
                </span>
              </div>
            </>
          )
        }

        <Separator class="my-6" />
        <div class="prose">
          <slot />
          <div class="flex items-center gap-2">
            <Separator class="flex-1" />
            <TegakiRenderer
              font={bundle}
              text="tantuyu. :)"
              time={{ mode: "uncontrolled", speed: 1.75, playing: false }}
              style="font-size: 32px"
              data-inview=""
            />
          </div>
        </div>

        {
          (prevPost || nextPost) && (
            <>
              <nav class="not-prose mt-4 grid grid-cols-2 gap-4">
                <div>
                  {prevPost && (
                    <a
                      href={`/blog/${prevPost.id}`}
                      class="group flex flex-col gap-1"
                    >
                      <span class="text-muted-foreground flex items-center gap-1 text-xs transition-all group-hover:-translate-x-2">
                        <ChevronLeft class="size-3" />
                        上一篇
                      </span>
                      <span class="group-hover:text-primary line-clamp-2 font-serif text-sm font-medium transition-colors">
                        {prevPost.title}
                      </span>
                    </a>
                  )}
                </div>
                <div class="text-right">
                  {nextPost && (
                    <a
                      href={`/blog/${nextPost.id}`}
                      class="group flex flex-col items-end gap-1"
                    >
                      <span class="text-muted-foreground flex items-center gap-1 text-xs transition-all group-hover:translate-x-2">
                        下一篇
                        <ChevronRight class="size-3" />
                      </span>
                      <span class="group-hover:text-primary line-clamp-2 font-serif text-sm font-medium transition-colors">
                        {nextPost.title}
                      </span>
                    </a>
                  )}
                </div>
              </nav>
            </>
          )
        }
      </article>

      <!-- Right: TOC -->
      <div class="hidden w-[15%] shrink-0 lg:block">
        <div class="sticky top-30">
          <TableOfContents headings={headings ?? []} />
        </div>
      </div>
    </div>

    <script is:inline>
      // Attach before Tegaki's module script hydrates so we catch tegaki:ready.
      // Guard prevents duplicate listeners across view-transition navigations.
      if (!window._tegakiInviewSetup) {
        window._tegakiInviewSetup = true;
        document.addEventListener("tegaki:ready", function (e) {
          var container = e.target;
          if (
            !(container instanceof HTMLElement) ||
            !("inview" in container.dataset)
          )
            return;
          var engine = e.detail && e.detail.engine;
          if (!engine) return;
          var observer = new IntersectionObserver(
            function (entries) {
              if (entries[0].isIntersecting) {
                observer.disconnect();
                engine.play();
              }
            },
            { threshold: 0.5 },
          );
          observer.observe(container);
        });
      }
    </script>

    <script>
      function setupCopyButtons() {
        document
          .querySelectorAll<HTMLButtonElement>(".code-block .copy-btn")
          .forEach((btn) => {
            if (btn.dataset.initialized) return;
            btn.dataset.initialized = "true";
            let copying = false;
            btn.addEventListener("click", async () => {
              if (copying) return;
              copying = true;
              const code = btn.closest(".code-block")?.querySelector("code");
              if (!code) {
                copying = false;
                return;
              }
              await navigator.clipboard.writeText(code.textContent || "");
              const swap = btn.querySelector(".t-icon-swap") as HTMLElement;
              if (swap) swap.dataset.state = "b";
              await new Promise<void>((r) => setTimeout(r, 2000));
              if (swap) swap.dataset.state = "a";
              copying = false;
            });
          });
      }

      setupCopyButtons();
      document.addEventListener("astro:page-load", setupCopyButtons);
    </script>

    <script>
      import PhotoSwipeLightbox from "photoswipe/lightbox";
      import PhotoSwipe from "photoswipe";
      import "photoswipe/style.css";

      let lightbox: PhotoSwipeLightbox | null = null;

      function initPhotoSwipe() {
        // Destroy previous instance on navigation
        if (lightbox) {
          lightbox.destroy();
          lightbox = null;
        }

        lightbox = new PhotoSwipeLightbox({
          gallery: "article",
          children: ".lightbox-trigger",
          pswpModule: PhotoSwipe,
        });
        lightbox.init();
      }

      // Initialize on load and Astro view transitions
      initPhotoSwipe();
      document.addEventListener("astro:page-load", initPhotoSwipe);
    </script>
  </div>
</BaseLayout>
