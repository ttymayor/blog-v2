---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/avatar.jpg";
import { SITE_TITLE } from "@/consts";
import { ModeToggle } from "@/components/react/ModeToggle";
import { PenTool, User, House } from "@lucide/astro";
import { cn } from "@/lib/utils";

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");

const navItems = [
  { href: "/", label: "首頁", Icon: House, isHome: true },
  { href: "/blog", label: "文章", Icon: PenTool },
  { href: "/about", label: "關於", Icon: User },
];

// is blog post
const isBlogPost = pathname.startsWith("blog/");
---

<header
  class={cn(
    "pointer-events-auto fixed bottom-0 left-0 z-50 flex w-full flex-row items-center justify-center md:bottom-auto md:top-0 group",
    isBlogPost ? "lg:h-6 lg:items-start" : "",
  )}
>
  <nav
    id="nav-container"
    class={cn(
      "relative flex w-full items-center justify-around border-t border-white/20 bg-card p-2 shadow-2xl transition-all duration-300 ease-in-out dark:border-white/10 dark:bg-linear-to-br dark:from-white/10 dark:to-white/5 dark:shadow-black/60 md:mx-auto md:mt-4 md:w-[95%] md:max-w-5xl md:justify-between md:rounded-full md:border md:p-4",
      "md:bg-linear-to-br md:from-black/10 md:to-black/5 md:backdrop-blur-lg",
      isBlogPost ? "lg:-translate-y-full lg:group-hover:translate-y-0" : "",
    )}
    transition:name="header"
  >
    <!-- Desktop Logo (Hidden on Mobile) -->
    <a
      href="/"
      class="hidden md:flex relative z-10 shrink-0 items-center gap-3 transition-all active:scale-98"
    >
      <Image
        inferSize
        src={AvatarImage}
        alt="Avatar"
        class="h-10 w-10 rounded-full object-cover"
      />
      <h2 class="m-0 text-[1em] font-bold">
        {SITE_TITLE}
      </h2>
    </a>

    <div
      class="flex flex-1 flex-row justify-around md:flex-none md:justify-end md:gap-4 items-center"
    >
      {
        navItems.map(({ href, label, Icon, isHome }) => {
          const isActive = isHome
            ? pathname === "" || pathname === "/"
            : pathname.startsWith(href.replace("/", ""));

          return (
            <a
              href={href}
              data-nav-item
              data-active={isActive ? "true" : undefined}
              class:list={[
                "relative z-10 inline-flex whitespace-nowrap flex-col md:flex-row items-center justify-center gap-1 md:gap-2 rounded-full no-underline transition-all",
                "w-16 h-12 md:w-fit md:h-fit md:py-2 md:px-3",
                isHome ? "md:hidden" : "",
                isActive
                  ? "text-[#745525] md:text-foreground dark:text-[#d0ae7d] md:dark:text-foreground"
                  : "text-foreground/60 md:text-foreground/80 hover:text-foreground",
              ]}
            >
              <Icon class="size-5 md:size-5" />
              <span class="text-[10px] md:text-sm">{label}</span>
            </a>
          );
        })
      }
      <div
        class="flex flex-col items-center justify-center w-16 h-12 md:hidden"
      >
        <ModeToggle client:load />
      </div>
    </div>
  </nav>
</header>
