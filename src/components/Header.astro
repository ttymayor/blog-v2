---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/avatar.webp";
import { SITE_TITLE } from "@/consts";
import { ModeToggle } from "@/components/react/ModeToggle";
import { BookOpenText, Menu, PenTool, User } from "@lucide/astro";
import { cn } from "@/lib/utils";
import Drawer from "./ui/Drawer.astro";

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");

const navItems = [
  { href: "/jotting", label: "隨筆", Icon: BookOpenText },
  { href: "/blog", label: "文章", Icon: PenTool },
  { href: "/about", label: "關於", Icon: User },
];

const isBlogPost = /^blog\/.+/.test(pathname);
---

<header
  id="site-header"
  data-blog-post={isBlogPost ? "" : undefined}
  class="group pointer-events-auto sticky top-0 z-50 flex w-full flex-row items-center justify-center"
>
  <nav
    id="nav-container"
    class={cn(
      "flex w-full md:max-w-5xl items-center rounded-none justify-between border-0 md:border-t p-3 shadow-lg transition-all duration-300 ease-in-out backdrop-blur-sm bg-linear-to-b from-card/95 via-card/80 to-card/95",
      // computer light mode
      "md:border-white/25 md:mx-4 md:mt-4 md:justify-between md:rounded-full md:p-4",
    )}
    transition:name="header"
  >
    <!-- Desktop Logo (Hidden on Mobile) -->
    <a href="/" class="flex shrink-0 items-center gap-3">
      <Image
        inferSize
        src={AvatarImage}
        alt="Avatar"
        class="size-10 rounded-full object-cover"
      />
      <h2 class="text-[1.25em] font-bold">
        {SITE_TITLE}
      </h2>
    </a>

    <!-- Navigation Links (Hidden on Mobile) -->
    <div class="hidden md:flex md:flex-row md:items-center md:gap-2">
      {
        navItems.map(({ href, label, Icon }) => {
          const isActive = pathname.startsWith(href.replace("/", ""));

          return (
            <a
              href={href}
              data-nav-item
              data-active={isActive ? "true" : undefined}
              class:list={[
                "inline-flex flex-row items-center justify-center gap-1 rounded-full whitespace-nowrap no-underline transition-all",
                "h-fit w-fit px-3 py-2",
                isActive
                  ? "text-foreground dark:text-foreground"
                  : "text-foreground/60 md:text-foreground/80 hover:text-foreground",
              ]}
            >
              <Icon class="size-5" />
              <span class="text-sm">{label}</span>
            </a>
          );
        })
      }
    </div>
    <div class="flex flex-row items-center justify-around md:hidden">
      <ModeToggle client:idle />
      <Drawer id="settings" title="目錄" description="網站目錄">
        <span
          slot="trigger"
          class="hover:text-foreground/80 p-2 transition-all"
        >
          <Menu class="size-5" />
        </span>

        <div id="drawer-content">
          <ul class="m-0 flex list-none flex-col gap-1">
            {
              navItems.map(({ href, label, Icon }) => {
                const isActive = pathname.startsWith(href.replace("/", ""));

                return (
                  <li>
                    <a
                      href={href}
                      data-nav-item
                      data-active={isActive ? "true" : undefined}
                      class:list={[
                        "flex flex-row items-center justify-start gap-2 rounded-lg whitespace-nowrap no-underline transition-all",
                        "mx-2 h-fit p-2",
                        isActive
                          ? "text-foreground dark:text-foreground bg-accent/10 dark:bg-accent/20"
                          : "text-foreground/60 md:text-foreground/80 hover:text-foreground",
                      ]}
                    >
                      <Icon class="size-5" />
                      <span class="text-sm">{label}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </Drawer>
    </div>
  </nav>
</header>
