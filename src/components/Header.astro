---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/avatar.jpg";
import { SITE_TITLE } from "@/consts";
import { ModeToggle } from "@/components/react/ModeToggle";
import { PenTool, User } from "@lucide/astro";

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");

const navItems = [
  { href: "/blog", label: "文章", Icon: PenTool },
  { href: "/about", label: "關於", Icon: User },
];
---

<header
  class="top pointer-events-auto fixed bottom-4 left-0 z-50 flex w-full justify-center flex-row items-center md:sticky md:top-0 gap-2"
>
  <nav
    class="md:mx-auto flex w-fit md:w-[95%] max-w-5xl items-center justify-between gap-2 md:gap-4 rounded-full bg-black/10 dark:bg-white/10 p-2 md:p-4 shadow-xl backdrop-blur-sm transition-all duration-500 ease-in-out md:mt-4"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-3 opacity-100 transition-opacity hover:opacity-75"
    >
      <Image
        inferSize
        src={AvatarImage}
        alt="Avatar"
        class="h-10 w-10 rounded-full object-cover"
      />
      <h2 class="m-0 hidden text-[1em] font-bold md:block">
        {SITE_TITLE}
      </h2>
    </a>

    <div class="flex flex-row gap-2 md:gap-4">
      {
        navItems.map(({ href, label, Icon }) => {
          const isActive = pathname.startsWith(href.replace("/", ""));
          return (
            <a
              href={href}
              class:list={[
                "inline-flex whitespace-nowrap flex-col md:flex-row w-10 h-10 md:w-fit items-center justify-center gap-1 md:gap-2 rounded-full px-0 md:py-2 md:px-3 text-[10px] md:text-sm no-underline transition-all",
                "hover:bg-black/10 dark:hover:bg-white/10",
                isActive
                  ? "text-[#687afc] md:text-foreground dark:text-[#b8c1ec] md:dark:text-foreground md:bg-black/15 md:dark:bg-white/15"
                  : "",
              ]}
            >
              <Icon class="size-4 md:size-5" />
              <span class="text-[10px] md:text-sm">{label}</span>
            </a>
          );
        })
      }
      <div class="hidden md:block">
        <ModeToggle client:load />
      </div>
    </div>
  </nav>
  <div
    class="rounded-full bg-black/10 p-2 shadow-xl backdrop-blur-sm dark:bg-white/10 md:hidden"
  >
    <ModeToggle client:load />
  </div>
</header>
