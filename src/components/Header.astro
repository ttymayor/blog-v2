---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/avatar.jpg";
import { Button } from "@/components/ui/button";
import { SITE_TITLE } from "@/consts";
import { ModeToggle } from "@/components/react/ModeToggle";
import { PenTool } from "@lucide/astro";

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const navItems = [{ href: "/blog", label: "文章" }];
---

<header
  class="top pointer-events-auto fixed bottom-4 left-0 z-50 flex w-full justify-center flex-row items-center md:sticky md:top-0 gap-2"
>
  <nav
    class="md:mx-auto flex w-fit md:w-[95%] max-w-5xl items-center justify-between gap-2 md:gap-4 rounded-full bg-black/10 dark:bg-white/10 p-2 md:p-4 shadow-xl backdrop-blur-sm transition-all duration-500 ease-in-out md:mt-4"
  >
    <a
      href="/"
      class="block shrink-0 opacity-100 transition-opacity hover:opacity-75"
    >
      <div class="flex items-center gap-3">
        <Image
          inferSize
          src={AvatarImage}
          alt="Avatar"
          decoding="async"
          loading="lazy"
          class="h-10 w-10 rounded-full object-cover"
        />
        <h2 class="m-0 hidden text-[1em] font-bold md:block">
          {SITE_TITLE}
        </h2>
      </div>
    </a>

    <div class="flex flex-row gap-4">
      {
        navItems.map((item) => {
          const isActive = pathname.startsWith(item.href.replace("/", ""));
          return (
            <Button
              client:load
              variant="link"
              className={`cursor-pointer w-10 h-10 md:w-fit rounded-full dark:hover:bg-white/10 hover:bg-black/10 ${isActive ? "dark:text-[#b8c1ec] md:dark:text-foreground md:bg-black/15 md:dark:bg-white/15" : ""}`}
            >
              <a
                href={item.href}
                class={`flex flex-col md:flex-row gap-1 md:gap-2 items-center justify-center text-[10px] md:text-sm no-underline ${isActive ? "font-bold" : ""}`}
              >
                {item.label === "文章" && <PenTool class="size-5" />}
                {item.label}
              </a>
            </Button>
          );
        })
      }
      <div class="hidden md:block">
        <ModeToggle client:load />
      </div>
    </div>
  </nav>
  <div
    class="rounded-full bg-black/10 p-2 shadow-xl backdrop-blur-sm dark:bg-white/10 md:hidden"
  >
    <ModeToggle client:load />
  </div>
</header>
