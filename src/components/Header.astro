---
import { Image } from "astro:assets";
import AvatarImage from "@/assets/avatar.jpg";
import { Button } from "@/components/ui/button";
import { SITE_TITLE } from "@/consts";
import { ModeToggle } from "@/components/react/ModeToggle";

// const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const navItems = [{ href: "/blog", label: "文" }];
---

<header
  class="top pointer-events-auto fixed bottom-4 left-0 z-50 flex w-full flex-col items-center md:sticky md:top-0 md:bottom-auto md:left-auto"
>
  <nav
    class="mx-auto flex w-[95%] max-w-5xl items-center justify-between gap-4 rounded-2xl bg-black/10 dark:bg-white/10 p-4 shadow-xl backdrop-blur-sm transition-all duration-500 ease-in-out md:mt-4"
  >
    <a
      href="/"
      class="block shrink-0 opacity-100 transition-opacity hover:opacity-75"
    >
      <div class="flex items-center gap-3">
        <Image
          inferSize
          src={AvatarImage}
          alt="Avatar"
          decoding="async"
          loading="lazy"
          class="h-10 w-10 rounded-full object-cover"
        />
        <h2 class="m-0 hidden text-[1em] font-bold md:block">
          {SITE_TITLE}
        </h2>
      </div>
    </a>

    <div class="flex flex-row gap-4">
      {
        navItems.map((item) => (
          <a href={item.href}>
            <Button client:load variant="link">
              {item.label}
            </Button>
          </a>
        ))
      }
      <ModeToggle client:load />
    </div>
  </nav>
</header>
