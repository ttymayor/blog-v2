---
import Badge from "@/components/ui/Badge.astro";
import Separator from "@/components/ui/Separator.astro";
import { relativeTime } from "@/lib/utils";
import type { BlogPost } from "@/types/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const transitionId = post.id.replace(/\//g, "-");
const badgeClass =
  "inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border border-transparent px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] [&>svg]:pointer-events-none [&>svg]:size-3";
---

<a
  href={`/blog/${post.id}`}
  data-slot="item"
  data-variant="default"
  data-size="sm"
  class="group/item hover:bg-accent/25 focus-visible:border-ring focus-visible:ring-ring/50 ring-border -mx-4 flex flex-wrap items-center gap-2.5 rounded-2xl border border-transparent p-4 text-sm transition-colors duration-100 outline-none hover:ring-1 focus-visible:ring-[3px]"
>
  {
    post.heroImage && (
      <img
        src={post.heroImage}
        alt={post.title}
        class="h-16 object-cover"
        loading="lazy"
        decoding="async"
        transition:name={`article-hero-${transitionId}`}
      />
    )
  }
  <div
    data-slot="item-content"
    class="flex min-w-0 flex-1 flex-col gap-1 [&+[data-slot=item-content]]:flex-none"
  >
    <div
      data-slot="item-title"
      class="flex w-fit items-center gap-2 font-serif text-lg leading-snug font-bold"
      style={`view-transition-name: article-title-${transitionId}`}
    >
      {post.title}
    </div>
    {
      post.excerpt && (
        <p
          data-slot="item-description"
          class="text-muted-foreground line-clamp-2 truncate text-sm leading-normal font-normal text-balance"
        >
          {post.excerpt}
        </p>
      )
    }
  </div>
  <div
    data-slot="item-footer"
    class="flex basis-full items-center justify-between gap-2"
  >
    {
      (post.tags.length || post.category) && (
        <div class="flex flex-wrap items-center gap-2">
          {post.category && <Badge variant="category">{post.category}</Badge>}
          {post.tags.map((tag) => (
            <Badge variant="tag">#{tag}</Badge>
          ))}
        </div>
      )
    }
    <Separator class="flex-1" />
    <time
      datetime={post.pubDate}
      data-post-relative-time
      class="text-muted-foreground shrink-0 text-xs"
    >
      {relativeTime(post.pubDate)}
    </time>
  </div>
</a>
