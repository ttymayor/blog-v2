---
import type { BlogPost } from "@/types/blog";
import PostLink from "@/components/PostLink.astro";
import { Search, SearchX, X } from "@lucide/astro";

interface Props {
  posts: BlogPost[];
  allTags: string[];
  allCategories: string[];
}

const { posts } = Astro.props;
---

<div class="space-y-6" id="blog-index">
  <!-- Search -->
  <div
    class="flex items-center gap-2 rounded-md border border-input bg-transparent shadow-xs transition-[color,box-shadow] focus-within:border-ring focus-within:ring-ring/50 focus-within:ring-[3px] dark:bg-input/30"
  >
    <Search class="ml-3 size-4 shrink-0 text-muted-foreground" />
    <input
      type="text"
      id="search-input"
      class="h-9 w-full min-w-0 bg-transparent px-2 py-1 text-base outline-none placeholder:text-muted-foreground md:text-sm"
      placeholder="搜尋文章..."
      aria-label="Search blog posts"
    />
    <button
      type="button"
      id="search-clear"
      class="mr-2 hidden shrink-0 cursor-pointer rounded-full p-0.5 text-muted-foreground transition-colors hover:text-foreground"
      aria-label="清除搜尋"
    >
      <X class="size-4" />
    </button>
  </div>

  <!-- Post count -->
  <p class="text-muted-foreground text-sm" id="post-count">
    {posts.length} 篇文章
  </p>

  <!-- Post grid -->
  <div class="grid gap-6 md:grid-cols-2" id="post-grid">
    {
      posts.map((post) => (
        <div
          class="blog-post-item"
          data-title={post.title.toLowerCase()}
          data-description={post.description.toLowerCase()}
        >
          <PostLink post={post} />
        </div>
      ))
    }
  </div>

  <!-- Empty state -->
  <div class="py-12 text-center hidden" id="empty-state">
    <div
      class="flex flex-col text-muted-foreground items-center justify-center gap-2"
    >
      <SearchX class="size-12" />
      <p class="text-lg">找不到文章</p>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const container = document.getElementById("blog-index");
    if (!container) return;

    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement | null;
    const searchClear = document.getElementById("search-clear");
    const postCount = document.getElementById("post-count");
    const postGrid = document.getElementById("post-grid");
    const emptyState = document.getElementById("empty-state");
    const postItems =
      container.querySelectorAll<HTMLElement>(".blog-post-item");

    let query = "";

    function readUrlParams() {
      const params = new URLSearchParams(window.location.search);
      query = params.get("q") || "";
    }

    function syncUrl() {
      const params = new URLSearchParams();
      if (query) params.set("q", query);
      const search = params.toString();
      const url = search ? `?${search}` : window.location.pathname;
      window.history.replaceState({}, "", url);
    }

    function applyFilters() {
      let visibleCount = 0;
      const searchLower = query.toLowerCase();

      postItems.forEach((item) => {
        let show = true;

        if (query) {
          const title = item.dataset.title || "";
          const desc = item.dataset.description || "";
          if (!title.includes(searchLower) && !desc.includes(searchLower)) {
            show = false;
          }
        }

        item.classList.toggle("hidden", !show);
        if (show) visibleCount++;
      });

      if (postCount) {
        postCount.textContent = query
          ? `找到 ${visibleCount} 篇文章`
          : `${visibleCount} 篇文章`;
      }

      if (postGrid) postGrid.classList.toggle("hidden", visibleCount === 0);
      if (emptyState) emptyState.classList.toggle("hidden", visibleCount > 0);

      syncUrl();
    }

    function updateClearButton() {
      searchClear?.classList.toggle("hidden", !query);
    }

    // Real-time search on input
    searchInput?.addEventListener("input", () => {
      query = searchInput.value;
      updateClearButton();
      applyFilters();
    });

    // Clear button
    searchClear?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      query = "";
      updateClearButton();
      applyFilters();
      searchInput?.focus();
    });

    // Init from URL
    readUrlParams();
    if (searchInput) searchInput.value = query;
    updateClearButton();
    applyFilters();
  });
</script>
