---
import type { ImageMetadata } from "astro";
import { Image as ImageComp } from "astro:assets";
interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
}
const { src, alt, width, height } = Astro.props;
const isLocalImage = typeof src !== "string";
const imageWidth = isLocalImage ? (src as ImageMetadata).width : width;
const imageHeight = isLocalImage ? (src as ImageMetadata).height : height;
const shouldHaveLightbox = !imageWidth || imageWidth >= 200;
const fullSizeUrl = isLocalImage ? (src as ImageMetadata).src : (src as string);
---

<div class="flex justify-center overflow-hidden rounded-md">
  {
    shouldHaveLightbox ? (
      <div class="flex flex-col items-center gap-1">
        <a
          href={fullSizeUrl}
          data-pswp-width={imageWidth}
          data-pswp-height={imageHeight}
          class="lightbox-trigger"
        >
          <ImageComp
            src={src as ImageMetadata}
            alt={alt}
            class="cursor-zoom-in"
            loading="lazy"
          />
        </a>
        <p class="text-muted-foreground text-center text-xs">{alt}</p>
      </div>
    ) : (
      <ImageComp
        src={src as ImageMetadata}
        alt={alt}
        class:list={"transition-all duration-300 ease-out hover:scale-101"}
        inferSize
      />
    )
  }
</div>
