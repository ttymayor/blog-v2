---
import { cn } from "@/lib/utils";

interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
  id?: string;
}

const { level, class: className, id, ...props } = Astro.props;
const Tag: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" = `h${level}`;

const baseStyles =
  "group scroll-m-28 tracking-tight font-bold text-foreground m-0 py-2";

const levelStyles: Record<number, string> = {
  1: "text-4xl",
  2: "text-3xl",
  3: "text-2xl",
  4: "text-xl",
  5: "text-lg",
  6: "text-base",
};
---

<a
  href={`#${id}`}
  class="no-underline text-foreground group"
  aria-label="Link to this section"
>
  <Tag
    id={id}
    class:list={cn(baseStyles, levelStyles[level], className)}
    {...props}
  >
    <slot />
  </Tag>
</a>
