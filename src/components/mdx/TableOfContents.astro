---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// Show H2, H3, and H4 in ToC
// Usually H1 is the title, so we start from H2.
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

if (tocHeadings.length === 0) return null;
---

<nav class="toc text-sm">
  <ul class="pl-4">
    {
      tocHeadings.map((heading) => {
        const indentClass =
          heading.depth === 3 ? "ml-4" : heading.depth === 4 ? "ml-8" : "";
        return (
          <li class={indentClass}>
            <a
              href={`#${heading.slug}`}
              data-toc-link
              data-target={heading.slug}
              class="toc-link text-muted-foreground hover:text-foreground block py-1.25"
            >
              <span class={`toc-bar depth-${heading.depth}`} />
              <span class="toc-label">{heading.text}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  function scrollToCurrentHeading() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;

    let id: string;
    try {
      id = decodeURIComponent(hash);
    } catch {
      return;
    }

    const heading = document.getElementById(id);
    if (!heading) return;

    requestAnimationFrame(() => {
      heading.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function initTableOfContents() {
    const tocLinks = document.querySelectorAll("[data-toc-link]");
    const headings = document.querySelectorAll("h2[id], h3[id], h4[id]");

    if (!tocLinks.length || !headings.length) return;

    const observerOptions = {
      rootMargin: "-80px 0px -80% 0px",
      threshold: 0,
    };

    let activeLink: Element | null = null;

    const setActiveLink = (link: Element) => {
      if (activeLink) {
        activeLink.classList.remove("active");
      }
      link.classList.add("active");
      activeLink = link;
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          const link = document.querySelector(
            `[data-toc-link][data-target="${id}"]`,
          );
          if (link) {
            setActiveLink(link);
          }
        }
      });
    }, observerOptions);

    headings.forEach((heading) => observer.observe(heading));

    // Handle click events for smooth scroll
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const target = link.getAttribute("data-target");
        const heading = document.getElementById(target!);
        if (heading) {
          const href = link.getAttribute("href");
          if (href && window.location.hash !== href) {
            window.history.pushState(null, "", href);
          }
          heading.scrollIntoView({ behavior: "smooth", block: "start" });
          // Update active state immediately on click
          setActiveLink(link);
        }
      });
    });
  }

  // Re-initialize after view transitions
  initTableOfContents();
  document.addEventListener("astro:page-load", () => {
    initTableOfContents();
    scrollToCurrentHeading();
  });
  window.addEventListener("load", scrollToCurrentHeading);
</script>

<style>
  .toc {
    max-height: calc(100vh - 14rem);
    overflow-y: auto;

    --sb-track-color: transparent;
    --sb-thumb-color: #9f9f9f;
    --sb-size: 6px;
  }

  .toc::-webkit-scrollbar-track {
    background: var(--sb-track-color);
    border-radius: 999px;
  }

  .toc::-webkit-scrollbar {
    width: var(--sb-size);
  }

  .toc::-webkit-scrollbar-thumb {
    background: var(--sb-thumb-color);
    border-radius: 999px;
  }

  .toc::-webkit-scrollbar-thumb:hover {
    background: #d1d1d1;
    border-radius: 999px;
  }

  /* ── Title ── */
  .toc-title {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    margin-bottom: 0;
    transition:
      max-height 0.25s ease,
      opacity 0.2s ease,
      margin-bottom 0.25s ease;
  }

  .toc:hover .toc-title {
    max-height: 2rem;
    opacity: 1;
    margin-bottom: 1rem;
  }

  /* ── Link container ── */
  .toc-link {
    display: flex;
    align-items: center;
    transition: color 0.15s;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
    margin-left: -0.75rem;
  }

  /* ── Bar indicator (collapsed state) ── */
  .toc-bar {
    display: block;
    flex-shrink: 0;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.25;
    margin-right: 20px;
    transition:
      opacity 0.2s ease,
      width 0.25s ease;
  }

  .toc-bar.depth-2 {
    width: 1.75rem;
  }
  .toc-bar.depth-3 {
    width: 1.25rem;
  }
  .toc-bar.depth-4 {
    width: 0.875rem;
  }

  .toc:hover .toc-bar {
    width: 0;
    opacity: 0;
    margin-right: 0;
  }

  /* ── Label (expanded state) ── */
  .toc-label {
    display: block;
    overflow: hidden;
    max-width: 0;
    height: 0.5rem;
    opacity: 0;
    white-space: nowrap;
    transition:
      max-width 0.25s ease,
      height 0.25s ease,
      opacity 0.2s ease 0.05s;
  }

  .toc:hover .toc-label {
    max-width: 14rem;
    height: 1.25rem;
    opacity: 1;
  }

  /* ── Active state (bar) ── */
  .toc-link.active .toc-bar {
    opacity: 1;
    height: 3px;
    background: var(--primary);
  }

  /* ── Active state (text) ── */
  .toc:hover .toc-link.active {
    color: var(--foreground);
    font-weight: 600;
    border-left-color: var(--primary);
  }
</style>
