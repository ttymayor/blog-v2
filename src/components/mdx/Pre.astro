---
import { Copy, Check } from "@lucide/astro";
import IconSwap from "@/components/IconSwap.astro";

const { class: className, ...props } = Astro.props;
const dataLanguage = props["data-language"];
const lang =
  (typeof dataLanguage === "string" && dataLanguage) ||
  (typeof className === "string" &&
    className.match(/(?:^|\s)language-([^\s]+)/)?.[1]);
---

<div class="code-block group">
  <div class="code-header">
    {lang && <span class="lang-badge">{lang}</span>}
    <button
      class="copy-btn ml-auto opacity-0 group-hover:opacity-100"
      aria-label="Copy code"
    >
      <IconSwap>
        <Copy slot="iconA" size={14} />
        <Check slot="iconB" size={14} />
      </IconSwap>
    </button>
  </div>
  <pre class={className} {...props}><slot /></pre>
</div>
