---
import type { BlogPost } from "@/types/blog";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.id}/`} class="group block h-full">
  <Card
    client:load
    className="group-hover:border-accent h-full shadow-xl transition-all group-hover:scale-102 active:scale-98"
  >
    <!-- <CardHeader client:load> -->
    <CardTitle className="px-6" client:load>
      <div class="flex flex-col gap-2">
        <div class="flex flex-wrap items-center gap-1.5">
          {post.category && <Badge variant={"default"}>{post.category}</Badge>}
          {
            post.tags?.length > 0 &&
              post.tags.slice(0, 3).map((tag) => (
                <Badge
                  client:load
                  key={tag}
                  variant={"secondary"}
                  className="rounded-xs"
                >
                  {tag}
                </Badge>
              ))
          }
          {
            post.tags?.length > 3 && (
              <Badge client:load variant="outline" className="text-xs">
                +{post.tags.length - 3}
              </Badge>
            )
          }
        </div>
        <h3
          class="mb-0 flex items-center gap-2 text-lg font-bold"
          transition:name={`post-title-${post.id.replace(/\//g, "-")}`}
        >
          {post.title}
        </h3>
      </div>
    </CardTitle>
    <!-- </CardHeader> -->
    <CardContent client:load>
      <p class="text-muted-foreground line-clamp-2 text-sm">
        {post.description || post.excerpt}
      </p>
      <p class="text-muted-foreground mt-2 shrink-0 font-mono text-sm">
        {new Date(post.pubDate).toISOString().slice(0, 10).replaceAll("-", ".")}
      </p>
    </CardContent>
  </Card>
</a>
