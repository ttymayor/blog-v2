---
// Zhuyin (Bopomofo) mapping for Traditional Chinese characters
const zhuyinMap: Record<string, string> = {
  // Common characters in greetings
  還: "ㄏㄞˊ",
  沒: "ㄇㄟˊ",
  入: "ㄖㄨˋ",
  睡: "ㄕㄨㄟˋ",
  嗎: "ㄇㄚ˙",
  早: "ㄗㄠˇ",
  上: "ㄕㄤˋ",
  好: "ㄏㄠˇ",
  午: "ㄨˇ",
  安: "ㄢ",
  喝: "ㄏㄜ",
  點: "ㄉㄧㄢˇ",
  水: "ㄕㄨㄟˇ",
  記: "ㄐㄧˋ",
  得: "ㄉㄜ˙",
  休: "ㄒㄧㄡ",
  息: "ㄒㄧˊ",
  晚: "ㄨㄢˇ",
  祝: "ㄓㄨˋ",
  你: "ㄋㄧˇ",
  有: "ㄧㄡˇ",
  個: "ㄍㄜˋ",
  夢: "ㄇㄥˋ",
  // Emojis and symbols (no conversion needed)
  "🥱": "🥱",
  "👋": "👋",
  "🌤️": "🌤️",
  "🍵": "🍵",
  "🌙": "🌙",
  "😴": "😴",
  " ": " ",
  "，": "，",
};

interface Props {
  text: string;
  speed?: number;
  zhuyinSpeed?: number;
  class?: string;
}

const { text, speed = 180, zhuyinSpeed = 90, class: className } = Astro.props;
---

<span class={className} data-zhuyin-typing data-text={text} data-speed={speed} data-zhuyin-speed={zhuyinSpeed}>
  <span class="typing-text"></span><span class="cursor">▍</span>
</span>

<style>
  .cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { prepareWithSegments } from "@chenglou/pretext";

  const zhuyinMap: Record<string, string> = {
    還: "ㄏㄞˊ",
    沒: "ㄇㄟˊ",
    入: "ㄖㄨˋ",
    睡: "ㄕㄨㄟˋ",
    嗎: "ㄇㄚ",
    早: "ㄗㄠˇ",
    上: "ㄕㄤˋ",
    好: "ㄏㄠˇ",
    午: "ㄨˇ",
    安: "ㄢ",
    喝: "ㄏㄜ",
    點: "ㄉㄧㄢˇ",
    水: "ㄕㄨㄟˇ",
    記: "ㄐㄧˋ",
    得: "ㄉㄜˊ",
    休: "ㄒㄧㄡ",
    息: "ㄒㄧˊ",
    晚: "ㄨㄢˇ",
    祝: "ㄓㄨˋ",
    你: "ㄋㄧˇ",
    有: "ㄧㄡˇ",
    個: "ㄍㄜ˙",
    夢: "ㄇㄥˋ",
    "🥱": "🥱",
    "👋": "👋",
    "🌤️": "🌤️",
    "🍵": "🍵",
    "🌙": "🌙",
    "😴": "😴",
    " ": " ",
    "，": "，",
  };

  const FONT = '16px "Geist", "Noto Sans TC", sans-serif';

  function toGraphemes(text: string): string[] {
    return prepareWithSegments(text, FONT).segments;
  }

  class ZhuyinTyper {
    private element: HTMLElement;
    private textElement: HTMLElement;
    public text: string;
    private speed: number;
    private zhuyinSpeed: number;
    private timeout: number | null = null;
    private cancelled = false;

    constructor(element: HTMLElement) {
      this.element = element;
      this.textElement = element.querySelector(".typing-text")!;
      this.text = element.dataset.text || "";
      this.speed = parseInt(element.dataset.speed || "180");
      this.zhuyinSpeed = parseInt(element.dataset.zhuyinSpeed || "90");
    }

    private randomSpeed(base: number): number {
      return base + Math.random() * base * 0.8 - base * 0.4;
    }

    async type() {
      this.stop();
      this.cancelled = false;
      this.textElement.textContent = "";
      let result = "";

      // Initial 1s pause before typing starts
      await this.sleep(1000);

      const chars = toGraphemes(this.text);

      for (const char of chars) {
        if (this.cancelled) return;

        const zhuyin = zhuyinMap[char];

        if (zhuyin && zhuyin !== char) {
          const zhuyinChars = toGraphemes(zhuyin);
          for (let j = 0; j < zhuyinChars.length; j++) {
            if (this.cancelled) return;
            this.textElement.textContent = result + zhuyinChars.slice(0, j + 1).join("");
            await this.sleep(this.randomSpeed(this.zhuyinSpeed));
          }
          result += char;
          this.textElement.textContent = result;
          await this.sleep(this.randomSpeed(this.speed));
        } else {
          result += char;
          this.textElement.textContent = result;
          await this.sleep(this.randomSpeed(this.speed));
        }
      }
    }

    private sleep(ms: number): Promise<void> {
      return new Promise((resolve) => {
        this.timeout = window.setTimeout(resolve, ms);
      });
    }

    stop() {
      this.cancelled = true;
      if (this.timeout) {
        clearTimeout(this.timeout);
        this.timeout = null;
      }
    }
  }

  function initZhuyinTyping() {
    const elements = document.querySelectorAll<HTMLElement>(
      "[data-zhuyin-typing]"
    );
    elements.forEach((element) => {
      // Skip if already initialized
      if (element.dataset.typerInit) return;
      element.dataset.typerInit = "true";

      const typer = new ZhuyinTyper(element);
      typer.type();

      element.addEventListener("retype", () => {
        typer.stop();
        typer.text = element.dataset.text || "";
        typer.type();
      });
    });
  }

  document.addEventListener("astro:page-load", initZhuyinTyping);
  initZhuyinTyping();
</script>
