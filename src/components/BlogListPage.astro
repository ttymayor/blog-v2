---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostBrowser from "@/components/blog/PostBrowser.astro";
import BlankBlock from "@/components/BlankBlock.astro";
import type { BlogPost } from "@/types/blog";

interface Props {
  posts: BlogPost[];
  initialPage: number;
}

const { posts, initialPage } = Astro.props;
---

<BaseLayout title="Blog">
  <BlankBlock />
  <div class="mx-auto w-full max-w-5xl px-4 py-12">
    <PostBrowser posts={posts} initialPage={initialPage} />
  </div>
</BaseLayout>
