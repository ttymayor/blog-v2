---
import { execSync } from "child_process";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import { GitBranch } from "@lucide/astro";
import { getPosts, getTotalWordCount } from "@/lib/blog";
import PostCalendar from "@/components/react/blog/PostCalendar";

const posts = await getPosts();
const totalWords = await getTotalWordCount();

const lastCommitHash = (() => {
  try {
    return execSync("git log -1 --format=%h", { cwd: process.cwd() })
      .toString()
      .trim();
  } catch {
    return null;
  }
})();

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/diff", label: "Diff" },
];

const socialLinks = [
  {
    href: "https://github.com/ttymayor",
    label: "GitHub",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    href: "mailto:hi@ttymayor.com",
    label: "Email",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>`,
  },
  {
    href: "/rss.xml",
    label: "RSS",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"/></svg>`,
  },
];
---

<footer class="mt-auto w-full">
  <!-- hatched divider -->
  <div
    class="h-8 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
  >
  </div>

  <!-- main footer body -->
  <div class="w-full border-t">
    <div
      class="mx-auto grid max-w-5xl grid-cols-1 gap-8 px-6 py-10 sm:grid-cols-3"
    >
      <!-- brand -->
      <div class="flex flex-col gap-2">
        <a
          href="/"
          class="text-foreground font-mono text-lg font-semibold tracking-tight transition-opacity hover:opacity-70"
        >
          {SITE_TITLE}
        </a>
        <p class="text-muted-foreground max-w-48 text-xs leading-relaxed">
          {SITE_DESCRIPTION}
        </p>
        <div class="mt-2">
          <PostCalendar
            client:load
            posts={posts}
            numWeeks={18}
            compact={true}
          />
          <p
            class="text-muted-foreground mx-auto max-w-5xl py-3 font-mono text-xs"
          >
            本站累計 {posts.length} 篇文章，共 {totalWords.toLocaleString()} 字
          </p>
        </div>
      </div>

      <!-- nav -->
      <div class="flex flex-col gap-3">
        <span
          class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Pages
        </span>
        <ul class="flex flex-col gap-2">
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-foreground/70 hover:text-foreground text-sm underline-offset-4 transition-colors hover:underline"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- social -->
      <div class="flex flex-col gap-3">
        <span
          class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
        >
          Connect
        </span>
        <ul class="flex flex-col gap-2">
          {
            socialLinks.map(({ href, label, svg }) => (
              <li>
                <a
                  href={href}
                  target={href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    href.startsWith("http") ? "noopener noreferrer" : undefined
                  }
                  class="footer-link text-foreground/70 hover:text-foreground inline-flex items-center gap-2 text-sm underline-offset-4 transition-colors hover:underline"
                >
                  <Fragment set:html={svg} />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- bottom bar -->
    <div class="border-t">
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4"
      >
        <p class="text-muted-foreground font-mono text-xs">
          &copy; {new Date().getFullYear()}
          {" "}{SITE_TITLE}
        </p>
        <div class="flex items-center gap-4">
          {
            lastCommitHash && (
              <a
                href="/diff"
                class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-xs transition-colors"
              >
                <GitBranch class="size-3" />
                {lastCommitHash}
              </a>
            )
          }
          <p class="text-muted-foreground h-fit text-xs">
            Built with
            {" "}
            <a
              href="https://astro.build"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground inline-flex underline underline-offset-2 transition-colors"
            >
              Astro
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="85"
                height="107"
                viewBox="0 0 85 107"
                class="size-5"
                fill="currentColor"
              >
                <path
                  d="M27.5893 91.1365C22.7555 86.7178 21.3443 77.4335 23.3583 70.7072C26.8503 74.948 31.6888 76.2914 36.7005 77.0497C44.4374 78.2199 52.0358 77.7822 59.2231 74.2459C60.0453 73.841 60.8052 73.3027 61.7036 72.7574C62.378 74.714 62.5535 76.6892 62.3179 78.6996C61.7452 83.5957 59.3086 87.3778 55.4332 90.2448C53.8835 91.3916 52.2437 92.4167 50.6432 93.4979C45.7262 96.8213 44.3959 100.718 46.2435 106.386C46.2874 106.525 46.3267 106.663 46.426 107C43.9155 105.876 42.0817 104.24 40.6844 102.089C39.2086 99.8193 38.5065 97.3081 38.4696 94.5909C38.4511 93.2686 38.4511 91.9345 38.2733 90.6309C37.8391 87.4527 36.3471 86.0297 33.5364 85.9478C30.6518 85.8636 28.37 87.6469 27.7649 90.4554C27.7187 90.6707 27.6517 90.8837 27.5847 91.1341L27.5893 91.1365Z"
                ></path>
                <path
                  d="M0 69.5866C0 69.5866 14.3139 62.6137 28.6678 62.6137L39.4901 29.1204C39.8953 27.5007 41.0783 26.3999 42.4139 26.3999C43.7495 26.3999 44.9325 27.5007 45.3377 29.1204L56.1601 62.6137C73.1601 62.6137 84.8278 69.5866 84.8278 69.5866C84.8278 69.5866 60.5145 3.35233 60.467 3.21944C59.7692 1.2612 58.5911 0 57.0029 0H27.8274C26.2392 0 25.1087 1.2612 24.3634 3.21944C24.3108 3.34983 0 69.5866 0 69.5866Z"
                ></path>
              </svg>
            </a>
            and
            {" "}
            <a
              href="https://react.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-foreground underline underline-offset-2 transition-colors"
              >React</a
            >
          </p>
        </div>
      </div>
    </div>

    <div class="h-16 md:hidden" aria-hidden="true"></div>
  </div>
</footer>
