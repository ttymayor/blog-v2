---
import { Image } from "astro:assets";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
import avatar from "@/assets/avatar.webp";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

const socialLinks = [
  {
    href: "https://github.com/ttymayor",
    label: "GitHub",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  },
  {
    href: "mailto:hi@ttymayor.com",
    label: "Email",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>`,
  },
  {
    href: "/rss.xml",
    label: "RSS",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"/></svg>`,
  },
];

const SITE_STARTED_AT = new Date("2026-01-29T17:45:00+08:00").getTime();
const HOUR_IN_MS = 60 * 60 * 1000;

function formatSiteUptime(now = Date.now()): string {
  const elapsedHours = Math.max(
    0,
    Math.floor((now - SITE_STARTED_AT) / HOUR_IN_MS),
  );
  const days = Math.floor(elapsedHours / 24);
  const hours = elapsedHours % 24;
  return `本站存活時間：${days} 天 ${hours} 小時`;
}

const siteUptime = formatSiteUptime();
---

<footer class="mt-auto w-full">
  <!-- hatched divider -->
  <div
    class="h-4 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
  >
  </div>

  <!-- main footer body -->
  <div class="rounded-t-md border-t">
    <div
      class="mx-auto flex max-w-5xl flex-row justify-between gap-4 px-4 py-10"
    >
      <div class="flex flex-col gap-4">
        <!-- brand -->
        <div class="flex flex-col gap-1">
          <a
            href="/"
            class="text-foreground w-fit font-mono text-lg font-semibold tracking-tight transition-opacity hover:opacity-70"
          >
            <h2>
              {SITE_TITLE}
            </h2>
          </a>
          <p class="text-muted-foreground max-w-48 text-xs leading-relaxed">
            {SITE_DESCRIPTION}
          </p>
        </div>

        <!-- nav -->
        <div class="flex flex-col items-start gap-1">
          <span
            class="text-muted-foreground text-center text-xs font-semibold tracking-widest uppercase"
          >
            Pages
          </span>
          <ul class="flex h-fit flex-row gap-3">
            {
              navLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="text-foreground/70 hover:text-foreground text-sm underline-offset-4 transition-colors hover:underline"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- social -->
        <div class="flex flex-col items-start gap-1">
          <span
            class="text-muted-foreground text-xs font-semibold tracking-widest uppercase"
          >
            Connect
          </span>
          <ul class="flex flex-row gap-3">
            {
              socialLinks.map(({ href, label, svg }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-link text-foreground/70 hover:text-foreground gap-1 text-sm underline-offset-4 transition-colors hover:underline"
                >
                  <li class="flex items-center gap-1">
                    <Fragment set:html={svg} />
                    {label}
                  </li>
                </a>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="flex items-end gap-4">
        <Image
          src={avatar}
          alt="avatar"
          width={1200}
          height={1200}
          class="footer-avatar aspect-square w-35 rotate-12 opacity-33 select-none"
          draggable="false"
        />
      </div>
    </div>
    <!-- bottom bar -->
    <div class="border-t">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 p-4"
      >
        <p class="text-muted-foreground font-mono text-xs">
          &copy; {new Date().getFullYear()}
          {" "}{SITE_TITLE}
        </p>
        <span
          class="text-muted-foreground text-xs tabular-nums"
          data-site-uptime>{siteUptime}</span
        >
      </div>
    </div>

    <div class="h-16 md:hidden" aria-hidden="true"></div>
  </div>
</footer>

<script>
  const SITE_STARTED_AT = new Date("2026-01-29T17:45:00+08:00").getTime();
  const HOUR_IN_MS = 60 * 60 * 1000;

  let siteUptimeTimer: number | undefined;

  function formatSiteUptime(now = Date.now()): string {
    const elapsedHours = Math.max(
      0,
      Math.floor((now - SITE_STARTED_AT) / HOUR_IN_MS),
    );
    const days = Math.floor(elapsedHours / 24);
    const hours = elapsedHours % 24;
    return `本站存活時間：${days} 天 ${hours} 小時`;
  }

  function updateSiteUptime() {
    const elements =
      document.querySelectorAll<HTMLElement>("[data-site-uptime]");
    const elapsed = Math.max(0, Date.now() - SITE_STARTED_AT);

    elements.forEach((element) => {
      element.textContent = formatSiteUptime();
    });

    window.clearTimeout(siteUptimeTimer);
    if (elements.length > 0) {
      siteUptimeTimer = window.setTimeout(
        updateSiteUptime,
        HOUR_IN_MS - (elapsed % HOUR_IN_MS),
      );
    }
  }

  updateSiteUptime();
  document.addEventListener("astro:page-load", updateSiteUptime);
</script>

<style>
  .footer-avatar {
    -webkit-mask-image: radial-gradient(circle, black 33%, transparent 70%);
    mask-image: radial-gradient(circle, black 33%, transparent 70%);
  }
</style>
