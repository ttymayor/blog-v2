---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div
    class="flex flex-col items-center justify-center min-h-[80dvh] px-4 select-none"
  >
    <h1 class="text-9xl" style="font-family: var(--font-geist-pixel-grid)">
      404
    </h1>
    <p class="text-lg text-muted-foreground mt-4">好像找不到頁面</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity"
    >
      回到首頁
    </a>
  </div>
</BaseLayout>
