---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ZhuyinTyping from "@/components/ZhuyinTyping.astro";
import { ArrowRight } from "@lucide/astro";
import PostList from "@/components/blog/PostList.astro";
import { SITE_DESCRIPTION } from "@/consts";
import { getPosts } from "@/lib/blog";
import Separator from "@/components/ui/Separator.astro";

const posts = await getPosts();
const latestPosts = posts.slice(0, 5);

const site_description = [
  SITE_DESCRIPTION,
  "AI 時代，更需要思考、表達，與提問",
  "/model tantuyu-sol",
  "> 我想吃薯條",
  "* Thinking...",
  "* 使用者說想吃薯條",
  "🍟 薯條好吃快去吃",
  "人生充滿喜劇",
  "🖐️",
  "這是什麼？",
  "五顆地瓜 🍠",
  "🦽 椅子推進器，噗嘶",
  "🗣️ 狗會說話嗎 ☝️☝️☝️",
  "🗣️ 狗會自己跳出角色嗎 ☝️☝️☝️",
];
---

<BaseLayout ogImage="/og/index.png">
  <div class="hidden md:block md:h-22" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-5xl px-4 py-12">
    <section id="hero" class="mb-10">
      <h2 id="greeting" class="font-serif text-3xl font-black tracking-wider">
        <ZhuyinTyping text="休息一下" class="greeting-text" />
      </h2>
      <p
        id="site-description"
        class="t-text-swap text-muted-foreground m-0 font-serif text-lg"
        data-texts={JSON.stringify(site_description)}
      >
        {SITE_DESCRIPTION}
      </p>
    </section>

    <script>
      const TEXT_SWAP_DUR = 200; // matches --text-swap-dur in transitions.css
      let descTimer: ReturnType<typeof setTimeout> | null = null;

      function initDescriptionRotation() {
        const elOrNull = document.getElementById("site-description");
        if (!elOrNull) return;
        const el: HTMLElement = elOrNull;

        const texts: string[] = JSON.parse(el.dataset.texts || "[]");
        if (texts.length < 2) return;

        let index = 0;

        if (descTimer) clearTimeout(descTimer);

        function scheduleNext() {
          const displayDur = Math.max(2000, texts[index].length * 150);

          descTimer = setTimeout(() => {
            // Phase 1: exit — old text slides up + blurs + fades
            el.classList.add("is-exit");

            setTimeout(() => {
              // Phase 2: swap text + jump to enter-start (below, no transition)
              index = (index + 1) % texts.length;
              el.textContent = texts[index];
              el.classList.remove("is-exit");
              el.classList.add("is-enter-start");

              // Phase 3: force reflow, then animate back to resting state
              el.getBoundingClientRect();
              el.classList.remove("is-enter-start");

              scheduleNext();
            }, TEXT_SWAP_DUR);
          }, displayDur);
        }

        scheduleNext();
      }

      initDescriptionRotation();
      document.addEventListener("astro:page-load", initDescriptionRotation);

      function updateGreeting() {
        const greetingElement = document.querySelector(".greeting-text");
        if (!greetingElement) return;

        const currentHour = new Date().getHours();
        let greeting = "休息一下"; // default

        if (currentHour >= 0 && currentHour < 6) {
          greeting = "還沒入睡嗎 🥱";
        } else if (currentHour >= 6 && currentHour < 11) {
          greeting = "早安，吃點好吃的 👋";
        } else if (currentHour >= 11 && currentHour < 13) {
          greeting = "午安 🌤️";
        } else if (currentHour >= 13 && currentHour < 17) {
          greeting = "喝點水，記得休息 🍵";
        } else if (currentHour >= 17 && currentHour < 21) {
          greeting = "休息吃晚餐 🌙";
        } else if (currentHour >= 21 && currentHour < 24) {
          greeting = "晚安，祝你有個好夢 😴";
        }

        // Update the data-text attribute and trigger re-typing
        greetingElement.setAttribute("data-text", greeting);

        // Trigger the typing animation
        const event = new CustomEvent("retype");
        greetingElement.dispatchEvent(event);
      }

      // Update greeting on page load
      updateGreeting();

      // Re-update after view transitions
      document.addEventListener("astro:page-load", updateGreeting);
    </script>

    <section id="latest-posts" class="flex flex-col gap-1">
      <div class="flex items-center justify-between">
        <h3 class="font-serif text-2xl font-bold">最新文章</h3>
        <a
          href="/blog"
          class="text-muted-foreground flex items-center gap-2 font-serif transition-all hover:translate-x-1"
          >瞧<ArrowRight class="size-5" /></a
        >
      </div>
      <PostList posts={latestPosts} />
    </section>
  </div>
</BaseLayout>
