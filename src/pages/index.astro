---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LatestPosts from "@/components/LatestPosts.astro";
import { ArrowRight } from "@lucide/astro";
---

<BaseLayout>
  <section id="hero" class="h-40 flex items-center justify-start">
    <div>
      <h2 class="text-3xl font-bold">休息一下</h2>
      <p class="text-lg text-muted-foreground">
        我還是年少輕狂、涉世未深的年輕人
      </p>
    </div>
  </section>

  <section id="latest-posts" class="space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-2xl font-bold">最新文章</h3>
      <a
        href="/blog"
        class="text-muted-foreground flex items-center gap-2 hover:translate-x-1 transition-all"
        >瞧<ArrowRight /></a
      >
    </div>
    <LatestPosts />
  </section>
</BaseLayout>
