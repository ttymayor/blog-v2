type SingleRole = { date: Date; name: string };
type RangeRole = { startDate: Date; endDate?: Date; name: string };
type Event = {
  kind: "single" | "range";
  title: string;
  description: string;
  role: (SingleRole | RangeRole)[];
  color?: string;
  img: string | ImageMetadata;
};

const events: Event[] = [
  {
    kind: "single",
    title: "SITCON",
    description:
      "SITCON 是由學生組成、投身資訊教育與推廣開源精神的社群。也是一個由學生主辦的資訊研討會，給學生們一個發表交流技術的舞台。",
    role: [
      { date: new Date("2026-03-08"), name: "Attendee" },
      { date: new Date("2025-03-08"), name: "Attendee" },
      { date: new Date("2024-03-09"), name: "Attendee" },
      { date: new Date("2022-09-04"), name: "Attendee" },
    ],
    // color: "#77b55a",
    img: "https://sitcon.org/branding/assets/logos/logo.svg",
  },
  {
    kind: "range",
    title: "COSCUP",
    description:
      "COSCUP 是由一群自由與開放原始碼軟體愛好者發起，致力於推廣開放原始碼精神與技術。",
    role: [
      {
        startDate: new Date("2025-08-09"),
        endDate: new Date("2025-08-10"),
        name: "Attendee",
      },
    ],
    img: "https://volunteer.coscup.org/img/coscup_logo_tw.png",
  },
  {
    kind: "range",
    title: "THU Hacker Club",
    description: "東海駭客社",
    role: [{ startDate: new Date("2025-07-01"), name: "Leader and Academic" }],
    img: hackerClubImg,
  },
  {
    kind: "range",
    title: "TSC 2026",
    description:
      "Taiwan Security Club。此次活動是第一次完全由學生聯合舉辦的 CTF，目標是成為全台灣資安社團交流活動，為臺灣剛入門的資安新手們建立一場符合新手導向的資安試煉大會，以燃起並延續新手對資安的熱忱為目的的活動。",
    role: [{ startDate: new Date("2025-11-08"), name: "Sponsor Group" }],
    img: "https://ctfd.tscctf.com/themes/tsc/static/img/logo.png?d=2015666e",
  },
];

function formatDate(d: Date) {
  return d.toLocaleDateString("zh-TW", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

function formatRoleDate(role: SingleRole | RangeRole) {
  if ("date" in role) return formatDate(role.date);
  if (role.endDate)
    return `${formatDate(role.startDate)} – ${formatDate(role.endDate)}`;
  return `${formatDate(role.startDate)} – Present`;
}
---

<BaseLayout>
  <!-- <TtyBadge variant={"default"}>default</TtyBadge>
  <TtyBadge variant={"accent"}>accent</TtyBadge>
  <TtyBadge variant={"outline"}>outline</TtyBadge>
  <TtyBadge variant={"tag"}>tag</TtyBadge>
  <TtyBadge variant={"category"}>category</TtyBadge> -->
  <HeroScrollSection client:load>
    <FlipCard client:load avatarSrc={avatar.src} />
  </HeroScrollSection>
  <div class="relative z-10 pointer-events-none">
    <div class="h-48 bg-gradient-to-b from-transparent to-background"></div>
    <div class="bg-background pointer-events-auto">
      <div class="max-w-4xl mx-auto px-4 w-full flex flex-col gap-16 pb-16">
  <section>
    <ProfileAvatar
      client:load
      src={avatar.src}
      alt="Avatar"
      name="tantuyu"
      description="I'm a <span class='font-bold text-foreground/90'>Full Stack Developer</span>. Love to build cool things that can help people. Give me a theme, and I'll work it out."
    />
  </section>
  <section
    id="tech-stacks-section"
    class="flex flex-col overflow-x-clip"
  >
    <h2 class="text-3xl font-bold mb-8">Tech Stacks</h2>
    <div class="grid grid-cols-8 sm:grid-cols-10 md:grid-cols-12 lg:grid-cols-14 gap-2 py-8">
        {
          techStacks.map((item) => (
            <div class="tech-stack-item group relative aspect-square p-2 rounded-md transition-all cursor-default flex items-center justify-center hover:border hover:border-white/20 hover:bg-linear-to-br hover:from-black/10 hover:to-black/5 hover:shadow-lg hover:shadow-black/10 hover:backdrop-blur-sm dark:hover:border-white/10 dark:hover:from-white/10 dark:hover:to-white/5 dark:hover:shadow-black/30">
              <img
                src={`${CDN}/${item.icon}.svg`}
                alt={item.name}
                class="size-8 rounded-none"
                loading="lazy"
                decoding="async"
              />
              <span class="tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs font-medium text-foreground bg-card border border-border rounded shadow-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity whitespace-nowrap z-10 max-w-[200px] text-center">
                {item.name}
              </span>
            </div>
          ))
        }
    </div>
  </section>
  <section
    class="flex flex-col"
  >
    <h2 class="text-3xl font-bold mb-8">Slides</h2>
    <div class="grid gap-6 md:grid-cols-2">
        {
          slides.map((slide) => (
            <div class="p-6 bg-card border border-border rounded-xl shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                  <Calendar class="w-4 h-4" />
                  <time>{slide.date}</time>
                </div>
                {slide.location && (
                  <span class="flex items-center gap-1.5 text-sm text-muted-foreground">
                    <MapPin class="w-4 h-4" />
                    {slide.location}
                  </span>
                )}
              </div>
              <a href={slide.link} class="text-foreground hover:underline">
                <h3 class="text-lg font-semibold">{slide.title}</h3>
              </a>
              <div class="flex flex-wrap items-center gap-4 mt-5">
                {slide.made_with && (
                  <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <Cpu class="w-4 h-4" />
                    <span>{slide.made_with.join(", ")}</span>
                  </div>
                )}
                {slide.pdf && (
                  <a
                    href={slide.pdf}
                    class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium text-foreground bg-card border border-border rounded-md hover:bg-muted transition-colors"
                  >
                    <FileText class="w-4 h-4" />
                    PDF
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
  </section>
  <section
    class="flex flex-col"
  >
    <h2 class="text-3xl font-bold mb-8">Projects</h2>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <div class="flex flex-col rounded-xl border border-border bg-card shadow-sm transition-shadow hover:shadow-md">
              <div class="overflow-hidden rounded-b-none rounded-t-xl">
                {typeof project.image === "string" ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full aspect-20/9 object-cover rounded-none hover:scale-105 transition-all"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={project.image}
                    alt={project.title}
                    class="w-full aspect-20/9 object-cover rounded-none hover:scale-105 transition-all"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <div class="flex flex-1 flex-col gap-3 p-4">
                <div class="flex-1">
                  <h3 class="text-base font-bold mb-1 text-card-foreground">
                    {project.title}
                    {project.site && (
                      <a
                        href={project.site}
                        class={buttonVariants({
                          variant: "link",
                          size: "icon-sm",
                        })}
                      >
                        <ExternalLink class="size-4" />
                      </a>
                    )}
                  </h3>
                  <p class="text-muted-foreground text-sm mb-0">
                    {project.description}
                  </p>
                </div>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="px-2 py-1 text-xs font-medium bg-muted text-muted-foreground rounded-md">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="flex gap-4">
                  {project.repo && (
                    <a
                      href={project.repo}
                      class={buttonVariants({
                        variant: "ghost",
                        size: "icon-lg",
                      })}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="size-5"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
  </section>
  <section
    id="event"
    class="flex flex-col py-16"
  >
    <h2 class="text-3xl font-bold mb-8">Events</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {
        events.map((event) => (
          <div class="ticket relative flex">
            <div
              class="ticket-left rounded-l-xl overflow-hidden"
              style={
                event.color ? `background-color: ${event.color}` : undefined
              }
            >
              <div class="ticket-side bg-[#ecefff] dark:bg-[#1e2238] flex items-center justify-center w-24 h-full p-4">
                <img
                  src={
                    typeof event.img === "string" ? event.img : event.img.src
                  }
                  alt={event.title}
                  class="w-14 h-14 object-contain aspect-square"
                />
              </div>
            </div>
            <div class="ticket-right rounded-r-xl border-l-dashed overflow-hidden bg-card flex-1 min-w-0">
              <div class="ticket-stub absolute left-0 top-2 bottom-2 w-px border-l border-dashed border-border" />
              <div class="p-4 pl-5">
                <h3 class="text-base font-bold text-card-foreground leading-snug">
                  {event.title}
                </h3>
                <p class="text-muted-foreground text-sm mt-1 line-clamp-2">
                  {event.description}
                </p>
                <div class="flex flex-wrap gap-2 mt-3">
                  {event.role.map((r) => (
                    <span class="inline-flex items-center gap-1.5 text-xs px-2 py-1 rounded-md bg-muted text-muted-foreground">
                      <span class="font-medium">{r.name}</span>
                      <span class="opacity-60">{formatRoleDate(r)}</span>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <section id="dev-rule" class="relative h-[calc(80dvh*4)]">
    <div
      class="sticky top-[10dvh] flex h-[80dvh] items-center select-none"
    >
      <div class="flex flex-row items-baseline gap-4 md:gap-6">
        <span class="text-xl font-bold md:text-4xl">開發原則</span>
        <div
          class="overflow-hidden text-xl md:text-4xl font-bold"
          style="height: 1.2em;"
        >
          <div
            id="hello-words"
            class="will-change-transform transition-transform duration-700 ease-[cubic-bezier(0.15,0.85,0.35,1)]"
          >
            <a
              class="block leading-[1.2] text-muted-foreground"
              href="https://www.conventionalcommits.org/en/v1.0.0/"
              >Conventional Commits</a
            >
            <a
              class="block leading-[1.2] text-muted-foreground"
              href="https://github.com/sparanoid/chinese-copywriting-guidelines"
              >中文文案排版指北</a
            >
            <a
              class="block leading-[1.2] text-muted-foreground"
              href="https://nohello.net/en/">No Hello</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
      </div>
    </div>
  </div>

  <script>
    let cleanup: (() => void) | null = null;

    function initHelloScroll() {
      cleanup?.();
      cleanup = null;

      const section = document.getElementById("dev-rule");
      const words = document.getElementById("hello-words");
      if (!section || !words) return;

      const wordCount = words.children.length;
      let currentIndex = -1;

      function onScroll() {
        const rect = section!.getBoundingClientRect();
        const scrollable = section!.offsetHeight - window.innerHeight;
        const progress = Math.min(Math.max(-rect.top / scrollable, 0), 1);
        const index = Math.min(Math.floor(progress * wordCount), wordCount - 1);

        if (index !== currentIndex) {
          currentIndex = index;
          words!.style.transform = `translateY(-${index * (100 / wordCount)}%)`;
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      cleanup = () => window.removeEventListener("scroll", onScroll);
    }

    document.addEventListener("astro:page-load", initHelloScroll);
  </script>
</BaseLayout>

<style>
  a {
    @apply underline hover:no-underline;
  }

  .ticket-left,
  .ticket-right {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ticket-left {
    transform-origin: center right;
    position: relative;
  }

  .ticket-left::before,
  .ticket-left::after {
    content: "";
    position: absolute;
    right: -1px;
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--background);
    z-index: 2;
  }

  .ticket-left::before {
    top: -1px;
    border-radius: 0 0 0 999px;
  }

  .ticket-left::after {
    bottom: -1px;
    border-radius: 999px 0 0 0;
  }

  .ticket-right {
    transform-origin: center left;
    position: relative;
  }

  .ticket-right::before,
  .ticket-right::after {
    content: "";
    position: absolute;
    left: -1px;
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--background);
    z-index: 2;
  }

  .ticket-right::before {
    top: -1px;
    border-radius: 0 0 999px 0;
  }

  .ticket-right::after {
    bottom: -1px;
    border-radius: 0 999px 0 0;
  }

  .ticket:hover .ticket-left {
    transform: translateX(-4px) rotate(-3deg);
  }

  .ticket:hover .ticket-right {
    transform: translateX(4px) rotate(3deg);
  }
</style>
