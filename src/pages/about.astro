---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FlipCard from "@/components/react/FlipCard";
import HeroScrollSection from "@/components/react/HeroScrollSection";
import ProfileAvatar from "@/components/react/ProfileAvatar";
import avatar from "@/assets/avatar.jpg";
import slideGitForensics from "@/assets/slides/20260423-git-and-forensics.png";
import slideLinux101 from "@/assets/slides/20250925-linux.png";

type Slide = {
  title: string;
  date: string;
  cover?: ImageMetadata;
  href?: string;
};

const slides: Slide[] = [
  {
    title: "Git & Forensics",
    date: "2026-04-23",
    cover: slideGitForensics,
    href: "https://url.ttymayor.com/git-forensics",
  },
  {
    title: "Linux - 你應該要認識的企鵝",
    date: "2025-09-25",
    cover: slideLinux101,
    href: "https://url.ttymayor.com/20250925-linux",
  },
];
---

<BaseLayout
  title="About"
  description="tantuyu 的個人網站"
  ogImage="/og/about.png"
>
  <!-- Hero: scroll-driven FlipCard -->
  <HeroScrollSection client:load>
    <FlipCard client:load avatarSrc={avatar.src} />
  </HeroScrollSection>

  <!-- Fade out the hero -->
  <div class="relative z-10 pointer-events-none">
    <div class="h-48 bg-linear-to-b from-transparent to-background"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 bg-background">
    <!-- hatched top divider -->
    <div
      class="h-8 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
    >
    </div>

    <!-- Profile section -->
    <section class="border-t w-full">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <ProfileAvatar
          client:load
          src={avatar.src}
          alt="tantuyu's avatar"
          name="tantuyu"
          description="I'm a <span class='font-semibold text-foreground/90'>Full Stack Developer</span> and student. I love building things that are actually useful — give me a problem and I'll work it out."
        />
      </div>
    </section>

    <!-- hatched divider -->
    <div
      class="h-6 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
    >
    </div>

    <!-- Bio section -->
    <section class="border-t w-full">
      <div
        class="max-w-5xl mx-auto px-6 py-12 grid grid-cols-1 gap-12 md:grid-cols-2"
      >
        <div>
          <h2
            class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4"
          >
            About
          </h2>
          <ul class="text-sm text-foreground/80 leading-relaxed">
            <li>在 Coding 👨‍💻 中，極度享受當下的時光</li>
            <li>Linux 使用者，使用過 Ubuntu、Kali、Arch、Fedora（正在探索）</li>
            <li>🔥Team Pixel（Pixel 7），預計入手 Pixel 11</li>
            <li>
              <strong class="text-foreground/90"
                >打 CTF
              </strong>但不怎麼強，有時間有朋友約就去打
            </li>
            <li>
              喜歡看臺灣<strong class="text-foreground/90">喜劇、漫才</strong>
            </li>
          </ul>
        </div>
        <div>
          <h2
            class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4"
          >
            Stack
          </h2>
          <ul
            class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-foreground/80"
          >
            {
              [
                "Next.js",
                "Astro",
                "React",
                "Vue",
                "Laravel",
                "TypeScript",
                "Tailwind CSS",
                "PostgreSQL",
              ].map((item) => (
                <li class="flex items-center gap-2">
                  <span class="inline-block size-1 rounded-full bg-muted-foreground/60 shrink-0" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- hatched divider -->
    <div
      class="h-6 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
    >
    </div>

    <!-- Slides section -->
    {
      slides.length > 0 && (
        <section class="border-t w-full">
          <div class="max-w-5xl mx-auto px-6 py-12">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-6">
              Slides
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
              {slides.map((slide) => {
                const Tag = slide.href ? "a" : "div";
                return (
                  <Tag
                    href={slide.href}
                    target={slide.href ? "_blank" : undefined}
                    rel={slide.href ? "noopener noreferrer" : undefined}
                    class={`group flex flex-col overflow-hidden rounded-2xl shadow-xl border bg-card transition-colors${slide.href ? " hover:border-foreground/30" : ""}`}
                  >
                    <div class="aspect-video w-full overflow-hidden bg-card relative">
                      {slide.cover ? (
                        <>
                          <div class="overflow-hidden rounded-2xl">
                            <img
                              src={slide.cover.src}
                              alt={slide.title}
                              class="h-full w-full object-cover  transition-transform duration-300 group-hover:scale-105"
                              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                            />

                            <div class="absolute inset-0 hidden flex-col items-center justify-center gap-1.5 text-muted-foreground/50">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <rect
                                  width="18"
                                  height="18"
                                  x="3"
                                  y="3"
                                  rx="2"
                                />
                                <path d="m9 9 5 12 1.8-5.2L21 14Z" />
                                <circle cx="10" cy="10" r="1" />
                              </svg>
                              <span class="text-xs">No preview</span>
                            </div>
                          </div>
                        </>
                      ) : (
                        <div class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 text-muted-foreground/50">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <rect width="18" height="18" x="3" y="3" rx="2" />
                            <path d="m9 9 5 12 1.8-5.2L21 14Z" />
                            <circle cx="10" cy="10" r="1" />
                          </svg>
                          <span class="text-xs">No preview</span>
                        </div>
                      )}
                    </div>
                    <div class="flex flex-col gap-1 rounded-2xl p-4">
                      <p class="text-sm font-medium text-foreground leading-snug">
                        {slide.title}
                      </p>
                      <p class="text-xs text-muted-foreground">{slide.date}</p>
                    </div>
                  </Tag>
                );
              })}
            </div>
          </div>
        </section>
      )
    }
  </div>
  <!-- <div class="h-8 border-t w-full"></div> -->
</BaseLayout>
