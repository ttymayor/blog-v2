---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProfileAvatar from "@/components/react/ProfileAvatar";
import BlankBlock from "@/components/BlankBlock.astro";
import TegakiRenderer from "tegaki/astro";
import bundle from "tegaki/fonts/caveat";
import avatar from "@/assets/avatar.jpg";
import slideGitForensics from "@/assets/slides/20260423-git-and-forensics.png";
import slideLinux101 from "@/assets/slides/20250925-linux.png";
import slideUnUsefulTool from "@/assets/slides/20260430-un-useful-tool.png";
import { SITE_TITLE } from "@/consts";

type Slide = {
  title: string;
  date: string;
  cover?: ImageMetadata;
  href?: string;
};

const slides: Slide[] = [
  {
    title: "最無/有用的工具",
    date: "2026-04-30",
    cover: slideUnUsefulTool,
    href: "https://url.ttymayor.com/un-useful-tool",
  },
  {
    title: "Git & Forensics",
    date: "2026-04-23",
    cover: slideGitForensics,
    href: "https://url.ttymayor.com/git-forensics",
  },
  {
    title: "Linux - 你應該要認識的企鵝",
    date: "2025-09-25",
    cover: slideLinux101,
    href: "https://url.ttymayor.com/20250925-linux",
  },
];
---

<BaseLayout
  title="About"
  description="tantuyu 的個人網站"
  ogImage="/og/about.png"
>
  <BlankBlock />
  <!-- Content -->
  <div class="bg-background relative z-10">
    <!-- Profile section -->
    <section class="w-full">
      <div class="mx-auto max-w-5xl px-6 py-12">
        <ProfileAvatar
          client:load
          src={avatar.src}
          alt="tantuyu's avatar"
          name={SITE_TITLE}
          words={["認真", "愛 Coding", "喜歡漫才", "用 Linux", "打 CTF"]}
        />
      </div>
    </section>

    <!-- hatched divider -->
    <div
      class="h-6 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
    >
    </div>

    <!-- Bio section -->
    <section class="w-full border-t">
      <div
        class="mx-auto grid max-w-5xl grid-cols-1 gap-12 px-6 py-12 md:grid-cols-2"
      >
        <div>
          <h2
            class="text-muted-foreground mb-4 text-xs font-semibold tracking-widest uppercase"
          >
            About
          </h2>
          <ul class="text-foreground/80 text-sm leading-relaxed">
            <li>在 Coding 👨‍💻 中，極度享受當下的時光</li>
            <li>Linux 使用者，使用過 Ubuntu、Kali、Arch、Fedora（正在探索）</li>
            <li>🔥Team Pixel（Pixel 7），預計入手 Pixel 11</li>
            <li>
              <strong class="text-foreground/90"
                >打 CTF
              </strong>但不怎麼強，有時間有朋友約就去打
            </li>
            <li>
              喜歡看臺灣<strong class="text-foreground/90">喜劇、漫才</strong>
            </li>
          </ul>
        </div>
        <div>
          <h2
            class="text-muted-foreground mb-4 text-xs font-semibold tracking-widest uppercase"
          >
            Stack
          </h2>
          <ul
            class="text-foreground/80 grid grid-cols-2 gap-x-6 gap-y-2 text-sm"
          >
            {
              [
                "Next.js",
                "Astro",
                "React",
                "Vue",
                "Laravel",
                "TypeScript",
                "Tailwind CSS",
                "PostgreSQL",
              ].map((item) => (
                <li class="flex items-center gap-2">
                  <span class="bg-muted-foreground/60 inline-block size-1 shrink-0 rounded-full" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- hatched divider -->
    <div
      class="h-6 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
    >
    </div>

    <!-- Slides section -->
    {
      slides.length > 0 && (
        <section class="w-full border-t">
          <div class="mx-auto max-w-5xl px-6 py-12">
            <h2 class="text-muted-foreground mb-6 text-xs font-semibold tracking-widest uppercase">
              Slides
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
              {slides.map((slide) => {
                const Tag = slide.href ? "a" : "div";
                return (
                  <Tag
                    href={slide.href}
                    target={slide.href ? "_blank" : undefined}
                    rel={slide.href ? "noopener noreferrer" : undefined}
                    class={`group bg-card flex flex-col overflow-hidden rounded-2xl border shadow-xl transition-colors${slide.href ? " hover:border-foreground/30" : ""}`}
                  >
                    <div class="bg-card relative aspect-video w-full overflow-hidden">
                      {slide.cover ? (
                        <>
                          <div class="overflow-hidden rounded-2xl">
                            <img
                              src={slide.cover.src}
                              alt={slide.title}
                              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                            />

                            <div class="text-muted-foreground/50 absolute inset-0 hidden flex-col items-center justify-center gap-1.5">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <rect
                                  width="18"
                                  height="18"
                                  x="3"
                                  y="3"
                                  rx="2"
                                />
                                <path d="m9 9 5 12 1.8-5.2L21 14Z" />
                                <circle cx="10" cy="10" r="1" />
                              </svg>
                              <span class="text-xs">No preview</span>
                            </div>
                          </div>
                        </>
                      ) : (
                        <div class="text-muted-foreground/50 absolute inset-0 flex flex-col items-center justify-center gap-1.5">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <rect width="18" height="18" x="3" y="3" rx="2" />
                            <path d="m9 9 5 12 1.8-5.2L21 14Z" />
                            <circle cx="10" cy="10" r="1" />
                          </svg>
                          <span class="text-xs">No preview</span>
                        </div>
                      )}
                    </div>
                    <div class="flex flex-col gap-1 rounded-2xl p-4">
                      <p class="text-foreground text-sm leading-snug font-medium">
                        {slide.title}
                      </p>
                      <p class="text-muted-foreground text-xs">{slide.date}</p>
                    </div>
                  </Tag>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <div
      class="h-6 w-full border-t [background:repeating-linear-gradient(-45deg,transparent,transparent_8px,#94a3b815_8px,#94a3b815_10px)]"
    >
    </div>
    <section class="w-full border-t">
      <div class="mx-auto max-w-5xl px-6 py-12">
        <div class="relative size-full">
          <div
            id="mask"
            class="bg-card/50 absolute flex size-full flex-col items-center justify-center rounded-2xl border backdrop-blur-md"
          >
            <TegakiRenderer
              font={bundle}
              text="Wish you well. You are the best. :D"
              time={{ mode: "uncontrolled", speed: 5, playing: false }}
              class="text-2xl md:text-4xl"
              data-inview=""
            />
            <TegakiRenderer
              font={bundle}
              text="You can tap me!"
              time={{ mode: "uncontrolled", speed: 10, playing: false }}
              class=""
              data-inview=""
            />
          </div>

          <iframe
            data-testid="embed-iframe"
            class="rounded-2xl"
            src="https://open.spotify.com/embed/album/0FKC566l6cp7gHF0QXe9G3?utm_source=generator&theme=0"
            width="100%"
            height="400px"
            allowfullscreen=""
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"></iframe>
        </div>
      </div>
    </section>
  </div>
  <!-- <div class="h-8 border-t w-full"></div> -->
</BaseLayout>

<script is:inline>
  // Attach before Tegaki's module script hydrates so we catch tegaki:ready.
  // Guard prevents duplicate listeners across view-transition navigations.
  function MaskEffect() {
    var mask = document.getElementById("mask");
    if (mask) {
      mask.style.cursor = "pointer";
      mask.addEventListener(
        "click",
        function () {
          mask.style.transition = "opacity 0.4s ease";
          mask.style.opacity = "0";
          mask.addEventListener(
            "transitionend",
            function () {
              mask.remove();
            },
            { once: true },
          );
        },
        { once: true },
      );
    }
  }

  document.addEventListener("astro:after-swap", MaskEffect());
  MaskEffect();

  if (!window._tegakiInviewSetup) {
    window._tegakiInviewSetup = true;
    document.addEventListener("tegaki:ready", function (e) {
      var container = e.target;
      if (
        !(container instanceof HTMLElement) ||
        !("inview" in container.dataset)
      )
        return;
      var engine = e.detail && e.detail.engine;
      if (!engine) return;
      var observer = new IntersectionObserver(
        function (entries) {
          if (entries[0].isIntersecting) {
            observer.disconnect();
            engine.play();
          }
        },
        { threshold: 0.5 },
      );
      observer.observe(container);
    });
  }
</script>
