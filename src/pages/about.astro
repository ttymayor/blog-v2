---
import BaseLayout from "@/layouts/BaseLayout.astro";

import FlipCard from "@/components/react/FlipCard";
import HeroScrollSection from "@/components/react/HeroScrollSection";
import ProfileAvatar from "@/components/react/ProfileAvatar";
import avatar from "@/assets/avatar.jpg";
import { Finder } from "@/components/react/Finder";
---

<BaseLayout title="About" description="tantuyu 的個人網站" ogImage="/og/about.png">
  <HeroScrollSection client:load>
    <FlipCard client:load avatarSrc={avatar.src} />
  </HeroScrollSection>
  <div class="relative z-10 pointer-events-none">
    <div class="h-48 bg-linear-to-b from-transparent to-background"></div>
    <div class="bg-background pointer-events-auto">
      <div class="max-w-4xl mx-auto px-4 w-full flex flex-col gap-16 pb-16">
        <section>
          <ProfileAvatar
            client:load
            src={avatar.src}
            alt="Avatar"
            name="tantuyu"
            description="I'm a <span class='font-bold text-foreground/90'>Full Stack Developer</span>. Love to build cool things that can help people. Give me a theme, and I'll work it out."
          />
        </section>
        <Finder client:load />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  a {
    @apply underline hover:no-underline;
  }
</style>
