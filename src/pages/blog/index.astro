---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/blog";
import PostBrowser from "@/components/react/blog/PostBrowser";
import BlankBlock from "@/components/BlankBlock.astro";

const posts = await getPosts();
---

<BaseLayout title="Blog">
  <BlankBlock />
  <div class="max-w-5xl w-full mx-auto px-4 py-12">
    <PostBrowser
      client:load
      posts={posts}
    />
  </div>
</BaseLayout>
