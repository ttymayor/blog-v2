---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/blog";
import PostBrowser from "@/components/react/blog/PostBrowser";

const posts = await getPosts();
---

<BaseLayout title="Blog">
  <div class="hidden md:block md:h-22" aria-hidden="true"></div>
  <div class="max-w-5xl w-full mx-auto px-4 py-12">
    <PostBrowser client:idle posts={posts} />
  </div>
</BaseLayout>
