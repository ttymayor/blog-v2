---
export const prerender = true;

import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "@/layouts/BlogPost.astro";
import Table from "@/components/mdx/Table.astro";
import Image from "@/components/mdx/Image.astro";
import H1 from "@/components/mdx/H1.astro";
import H2 from "@/components/mdx/H2.astro";
import H3 from "@/components/mdx/H3.astro";
import H4 from "@/components/mdx/H4.astro";
import H5 from "@/components/mdx/H5.astro";
import H6 from "@/components/mdx/H6.astro";
import { getAdjacentPosts } from "@/lib/blog";
import Spoiler from "@/components/react/Spoiler";
import YouTubeEmbed from "@/components/mdx/YouTubeEmbed.astro";
import Pre from "@/components/mdx/Pre.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

dayjs.extend(utc);

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: { id: any; }) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const lastModified = dayjs(remarkPluginFrontmatter.lastModified).utc();
const { prevPost, nextPost } = await getAdjacentPosts(post.id);
---

<BlogPost
  {...post.data}
  slug={post.id}
  body={post.body}
  headings={headings}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  wordCount={remarkPluginFrontmatter.wordCount}
  lastModified={lastModified}
  readMinutes={remarkPluginFrontmatter.readMinutes}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content
    components={{
      table: Table,
      img: Image,
      h1: H1,
      h2: H2,
      h3: H3,
      h4: H4,
      h5: H5,
      h6: H6,
      Spoiler,
      YouTubeEmbed,
      pre: Pre,
    }}
  />
</BlogPost>
