{
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "*.tsx",
      "options": {
        "parser": "tsx"
      }
    },
    {
      "files": "*.ts",
      "options": {
        "parser": "typescript"
      }
    }
  ],
  "semi": true,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "tabWidth": 2
}
